generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// A client (e.g. Personic Health) that may run several practices under different
// business names / Tax IDs, typically one per state.
model Organization {
  id        String     @id @default(cuid())
  name      String
  createdAt DateTime   @default(now())
  practices Practice[]
  // Client account (a billing company's customer): details, status, commercial terms and onboarding.
  legalName          String?
  taxId              String?
  contactName        String?
  contactEmail       String?
  contactPhone       String?
  accountManager     String?
  status             String    @default("ACTIVE")
  statusReason       String?
  terminatedAt       DateTime?
  feePercent         Float?
  minimumMonthlyCents Int?
  invoiceDay         Int       @default(1)
  onboarding         String?
  notes              String?
  // Sign-in policy for every user in the organization's practices.
  maxFailedLogins    Int       @default(5)
  lockoutMinutes     Int       @default(15)
  passwordMaxAgeDays Int       @default(0)
  twoFactorRequired  Boolean   @default(false)
  idleTimeoutMinutes Int       @default(0)
  ipAllowlist        String?
  ipAllowlistExempt  String?
}

model Practice {
  interfaceMessages InterfaceMessage[]
  textMacros     TextMacro[]
  educationResources EducationResource[]
  reportSubscriptions ReportSubscription[]
  monitoringRules MonitoringRule[]
  importMappings ImportMapping[]
  payerRuleSets  PayerRuleSet[]
  periodCloses   PeriodClose[]
  bankImports    BankImport[]
  statementRuns  StatementRun[]
  paymentPlans   PaymentPlan[]
  collectionsCases CollectionsCase[]
  claimFollowUps ClaimFollowUp[]
  patientAlerts PatientAlert[]
  woundProducts WoundProduct[]
  treatmentSteps TreatmentStep[]
  woundTreatments WoundTreatment[]
  patientMessages PatientMessage[]
  id           String        @id @default(cuid())
  name         String
  slug         String        @unique
  state        String?
  organizationId String?
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  createdAt    DateTime      @default(now())
  locations    Location[]
  users        User[]
  memberships  Membership[]
  patients     Patient[]
  appointments Appointment[]
  encounters   Encounter[]
  charges      Charge[]
  auditLogs    AuditLog[]
  sessions     Session[]
  wounds       Wound[]
  availability ProviderAvailability[]
  reservedTimes ReservedTime[]
  payers       Payer[]
  eligibilityChecks EligibilityCheck[]
  billingProviders BillingProvider[]
  deposits     Deposit[]
  superbillTemplates SuperbillTemplate[]
  statements   Statement[]
  renderingProviders RenderingProvider[]
  intakeCases  IntakeCase[]
  vobDecisions VobDecision[]
  claims       Claim[]
  codes        PracticeCode[]
  documentTemplates DocumentTemplate[]
  chartWorkflows    ChartWorkflow[]
  documentationViews DocumentationView[]
  settings          PracticeSettings?
  patientDocuments  PatientDocument[]
  visitTypes        VisitType[]
  schedulerSettings SchedulerSettings?
  cancellationReasons CancellationReason[]
  calendarFilters   CalendarFilterSet[]
  schedulerResources SchedulerResource[]
  systemMessages    SystemMessage[]
  faxes             Fax[]
  intakePackets     IntakePacket[]
  intakeRequests    IntakeRequest[]
  messages          MessageLog[]
  automationRules   AutomationRule[]
  surveys           SurveyResponse[]
  kioskLinks        KioskLink[]
  connectSettings   ConnectSettings?
  eraFiles          EraFile[]
  recalls           Recall[]
  careRules         CareRule[]
  prescriptions     Prescription[]
  immunizations     Immunization[]
  letterTemplates   LetterTemplate[]
  clinicClosures    ClinicClosure[]
  apiClients        ApiClient[]
  duplicateDismissals DuplicateDismissal[]
  patientPayments   PatientPayment[]
  orderProviders    OrderProvider[]
  orderCatalog      OrderCatalogItem[]
  clinicalOrders    ClinicalOrder[]
  receipts          Receipt[]
  tasks             Task[]
  outgoingReferrals OutgoingReferral[]
  importBatches     ImportBatch[]
  claimDenials      ClaimDenial[]
  disclosures       Disclosure[]
  amendmentRequests AmendmentRequest[]
  emergencyAccesses EmergencyAccess[]
  careTeamMembers   CareTeamMember[]
  healthConcerns    HealthConcern[]
  patientGoals      PatientGoal[]
  implantableDevices ImplantableDevice[]
  sdohScreenings    SdohScreening[]
  customFields      CustomField[]
  vaccineLots       VaccineLot[]
  serviceTypes      ServiceType[]
  chargeSchedules   ChargeSchedule[]
  payerPlans        PayerPlan[]
}

model Membership {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  practiceId String
  practice   Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  role       String
  // Per-user changes to the role's permissions in this practice: JSON { "permission.key": true | false }.
  permissions String?
  createdAt  DateTime @default(now())

  @@unique([userId, practiceId])
}

model Location {
  billingOverrides PayerBillingOverride[]
  id           String        @id @default(cuid())
  practiceId   String
  practice     Practice      @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  name         String
  addressLine1 String?
  city         String?
  state        String?
  zip          String?
  phone        String?
  createdAt    DateTime      @default(now())
  appointments Appointment[]
  availability ProviderAvailability[]
  reservedTimes ReservedTime[]
  npi          String?
  claims       Claim[]
  // Office hours: JSON [{ day: 0-6, closed, start "08:00", end "19:00" }] (Scheduler admin -> Office hours).
  officeHours        String?
  slotMinutes        Int     @default(15)
  showNonOfficeHours Boolean @default(false)
  promptOutsideHours Boolean @default(true)
  resources          SchedulerResource[]
  // ---- Site of service administration ----
  serviceTypeId  String?
  serviceType    ServiceType? @relation(fields: [serviceTypeId], references: [id], onDelete: SetNull)
  addressLine2   String?
  fax            String?
  email          String?
  // CMS place of service code used for visits at this site (box 24B).
  placeOfService String?
  taxId          String?
  groupNpi       String?
  ptan           String?
  // The facility bills for services here (the practice does not send a professional claim).
  facilityBilling Boolean @default(false)
  active         Boolean  @default(true)
}

model User {
  textMacros      TextMacro[]
  referrersOwned  RenderingProvider[] @relation("ReferrerBdOwner")
  reportSubscriptions ReportSubscription[]
  followUpsOwned  ClaimFollowUp[] @relation("FollowUpOwner")
  alertsCreated   PatientAlert[] @relation("AlertCreator")
  alertsResolved  PatientAlert[] @relation("AlertResolver")
  alertsAssigned  PatientAlert[] @relation("AlertAssignee")
  alertAcks       AlertAcknowledgement[]
  woundTreatments WoundTreatment[]
  id          String        @id @default(cuid())
  practiceId  String
  practice    Practice      @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  email       String        @unique
  username    String?       @unique
  // Master login: consolidated cross-practice views across every practice the user belongs to.
  isMaster    Boolean       @default(false)
  name        String
  role        String        @default("CLINICIAN")
  passwordHash String
  npi         String?
  specialty   String?
  active      Boolean       @default(true)
  createdAt   DateTime      @default(now())
  appointments Appointment[] @relation("ProviderAppointments")
  encounters  Encounter[]   @relation("ProviderEncounters")
  sessions    Session[]
  prescriptions Medication[] @relation("PrescribedMedications")
  labOrders   LabOrder[]    @relation("OrderedLabs")
  auditLogs   AuditLog[]
  memberships Membership[]
  woundAssessments WoundAssessment[] @relation("WoundAssessor")
  debridements     Debridement[]     @relation("DebridementPerformer")
  availability     ProviderAvailability[] @relation("ProviderAvailability")
  reservedTimes    ReservedTime[]         @relation("ProviderReservedTime")
  renderingProvider        RenderingProvider?
  enrollmentAssignments    ProviderEnrollment[] @relation("EnrollmentAssignee")
  enrollmentActivities     EnrollmentActivity[]
  documentsUploaded        ProviderDocument[]   @relation("DocumentUploader")
  verificationChecks       PrimarySourceCheck[]
  intakeCasesOwned         IntakeCase[]         @relation("IntakeOwner")
  intakeActivities         IntakeActivity[]
  encountersAsStaff        Encounter[]          @relation("EncounterClinicalStaff")
  encountersCoded          Encounter[]          @relation("EncounterCoder")
  appointmentsAsStaff      Appointment[]        @relation("AppointmentClinicalStaff")
  encounterSignatures      EncounterSignature[]
  encounterEvents          EncounterEvent[]
  claimEvents              ClaimEvent[]
  // Provider signature on file (PNG data URL), stamped onto signed records.
  signatureImage           String?
  signatureUpdatedAt       DateTime?
  // JSON list of widget keys shown on the patient dashboard, in order (null = default layout).
  patientDashboard         String?
  // The practice dashboard tiles this user chose ("My view"), JSON list of tile keys.
  dashboardTiles           String?
  // Account security: lockout after failed sign-ins, forced password change, second factor.
  failedLogins             Int       @default(0)
  lockedUntil              DateTime?
  mustChangePassword       Boolean   @default(false)
  passwordChangedAt        DateTime?
  twoFactorMethod          String    @default("NONE")
  documentsCompleted       EncounterDocument[]  @relation("DocumentCompletedBy")
  documentsSigned          EncounterDocument[]  @relation("DocumentSignedBy")
  attachmentsUploaded      EncounterAttachment[]
  patientDocumentsUploaded PatientDocument[]    @relation("PatientDocumentUploader")
  patientDocumentsReviewed PatientDocument[]    @relation("PatientDocumentReviewer")
}

model ProviderAvailability {
  id         String   @id @default(cuid())
  practiceId String
  practice   Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  providerId String
  provider   User     @relation("ProviderAvailability", fields: [providerId], references: [id], onDelete: Cascade)
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  dayOfWeek  Int
  startTime  String
  endTime    String
  createdAt  DateTime @default(now())
}

model ReservedTime {
  id         String    @id @default(cuid())
  practiceId String
  practice   Practice  @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  providerId String
  provider   User      @relation("ProviderReservedTime", fields: [providerId], references: [id], onDelete: Cascade)
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id])
  title      String
  startsAt   DateTime
  endsAt     DateTime
  createdAt  DateTime  @default(now())
}

model AuditLog {
  id         String    @id @default(cuid())
  practiceId String?
  practice   Practice? @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  detail     String?
  createdAt  DateTime  @default(now())
}

model Session {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  activePracticeId String?
  activePractice   Practice? @relation(fields: [activePracticeId], references: [id], onDelete: SetNull)
  expiresAt        DateTime
  createdAt        DateTime  @default(now())
  // Idle timeout and the emailed second factor (only the code's hash is kept).
  lastSeenAt       DateTime  @default(now())
  twoFactorPending Boolean   @default(false)
  otpHash          String?
  otpExpiresAt     DateTime?
  otpAttempts      Int       @default(0)
}

model Patient {
  educationResources EducationResource[]
  paymentPlans PaymentPlan[]
  collectionsCases CollectionsCase[]
  // Statement delivery and hold (Claims & balance page).
  statementPreference String   @default("PAPER")
  statementHold       Boolean  @default(false)
  statementHoldReason String?
  statementHoldUntil  DateTime?
  alerts       PatientAlert[]
  teamMessages PatientMessage[]
  id              String        @id @default(cuid())
  practiceId      String
  practice        Practice      @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  mrn             String
  firstName       String
  lastName        String
  dob             DateTime
  sex             String
  phone           String?
  email           String?
  addressLine1    String?
  city            String?
  state           String?
  zip             String?
  status          String        @default("ACTIVE")
  preferredLanguage String?
  referringPhysicianId String?
  referringPhysician   RenderingProvider? @relation("ReferringProvider", fields: [referringPhysicianId], references: [id], onDelete: SetNull)
  race            String?
  ethnicity       String?
  maritalStatus   String?
  employmentStatus String?
  smokingStatus   String?
  emergencyContactName String?
  emergencyContactPhone String?
  emergencyContactRelationship String?
  guarantorName   String?
  guarantorRelationship String?
  guarantorPhone  String?
  guarantorPatientId String?
  guarantorPatient   Patient?  @relation("GuarantorAccount", fields: [guarantorPatientId], references: [id])
  dependents      Patient[] @relation("GuarantorAccount")
  guarantorAddress String?

  // ---- Full registration (Add Patient) ----
  // Identification
  preferredName   String?
  middleName      String?
  suffix          String?
  // Last four digits only; the full number is never stored.
  ssnLast4        String?
  genderIdentity  String?
  sexualOrientation String?
  pronoun         String?
  // Every race selected (comma separated codes); `race` keeps the first for single-value outputs.
  races           String?
  religion        String?
  tribalAffiliation String?
  interpreterNeeded Boolean     @default(false)
  preferredCommunication String?
  careCenterId    String?
  previousFirstName  String?
  previousMiddleName String?
  previousLastName   String?
  nameChangedAt   DateTime?
  occupation      String?
  occupationIndustry String?
  // Contact
  phoneType       String?
  phone2          String?
  phone2Type      String?
  noEmail         Boolean       @default(false)
  // PRIMARY | SECONDARY: which address is current
  currentAddress  String        @default("PRIMARY")
  addressLine2    String?
  county          String?
  // JSON { line1, line2, city, state, zip, county }
  secondaryAddress String?
  previousAddress  String?
  // Admission
  siteOfServiceId String?
  admissionDate   DateTime?
  consult         Boolean       @default(false)
  palliativeCare  Boolean       @default(false)
  medicareAdmission String?
  nonWoundDiagnosis Boolean     @default(false)
  howHeard        String?
  onsetDate       DateTime?
  autoAccident    Boolean       @default(false)
  autoAccidentState String?
  autoAccidentDate  DateTime?
  // Care providers and instructions
  woundCarePhysicianId   String?
  primaryCarePhysicianId String?
  supervisingPhysicianId String?
  referralDate    DateTime?
  externalProviders String?
  pharmacyName    String?
  pharmacyPhone   String?
  pharmacyFax     String?
  pharmacyAddress String?
  emergencyContactEmail String?
  // JSON { line1, line2, city, state, zip }
  emergencyContactAddress String?
  emergencyContactGuardian Boolean @default(false)
  emergencyContactGuardianAdLitem Boolean @default(false)
  motherFirstName  String?
  motherMaidenName String?
  homeHealthNurse   String?
  homeHealthCompany String?
  // JSON [{ firstName, lastName }]
  portalRepresentatives String?
  registrationNotes String?
  photoPath       String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  insurances      Insurance[]
  appointments    Appointment[]
  encounters      Encounter[]
  allergies       Allergy[]
  problems        Problem[]
  medications     Medication[]
  labOrders       LabOrder[]
  wounds          Wound[]
  eligibilityChecks EligibilityCheck[]
  statements      Statement[]
  intakeCases     IntakeCase[]
  documents       PatientDocument[]
  intakeRequests  IntakeRequest[]
  surveys         SurveyResponse[]

  @@unique([practiceId, mrn])
  claims          Claim[]
  recalls         Recall[]
  prescriptions   Prescription[]
  immunizations   Immunization[]
  careOverrides   CareRuleOverride[]
  payments        PatientPayment[]
  clinicalOrders  ClinicalOrder[]
  receipts        Receipt[]
  tasks           Task[]
  outgoingReferrals OutgoingReferral[]

  // ---- Privacy ----
  // Restricted chart: only the care team and administrators open it; anyone else must record a reason first.
  restricted        Boolean   @default(false)
  restrictedReason  String?
  // Consent to automated texts and calls (TCPA): YES | NO, null = not asked yet.
  textConsent       String?
  voiceConsent      String?
  consentRecordedAt DateTime?
  // VERBAL | WRITTEN | FORM | PORTAL
  consentMethod     String?
  consentRecordedById String?
  // Values of the practice's custom fields (JSON { key: value }).
  customFields      String?
  disclosures       Disclosure[]
  amendmentRequests AmendmentRequest[]
  emergencyAccesses EmergencyAccess[]
  careTeam          CareTeamMember[]
  healthConcerns    HealthConcern[]
  goals             PatientGoal[]
  implantableDevices ImplantableDevice[]
  sdohScreenings    SdohScreening[]
}

model Insurance {
  id         String   @id @default(cuid())
  patientId  String
  patient    Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  payerId    String
  payer      Payer    @relation(fields: [payerId], references: [id])
  memberId   String
  groupNumber String?
  planName   String?
  isPrimary  Boolean  @default(true)
  // PRIMARY | SECONDARY | TERTIARY
  rank       String   @default("PRIMARY")
  // X12 individual relationship code: 18 self, 01 spouse, 19 child, G8 other
  relationshipToInsured String @default("18")
  insuredFirstName  String?
  insuredLastName   String?
  insuredDob        DateTime?
  insuredSex        String?
  insuredAddressLine1 String?
  insuredCity       String?
  insuredState      String?
  insuredZip        String?
  effectiveDate     DateTime?
  terminationDate   DateTime?
  active     Boolean  @default(true)
  claims     Claim[]
  // Office-visit copay on the card / plan.
  copayCents Int?
  groupName         String?
  insuredMiddleName String?
  insuredPhone      String?
  // Benefits as verified at registration.
  deductibleCents    Int?
  deductibleMetCents Int?
  coveragePercent    Int?
  verifiedAt         DateTime?
  verifiedWith       String?
  // YES | NO | UNKNOWN
  authRequired       String?
  priorAuthRequired  String?
  notes              String?
  authorizations     InsuranceAuthorization[]
}

model Payer {
  ruleSets     PayerRuleSet[]
  id           String      @id @default(cuid())
  practiceId   String
  practice     Practice    @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  name         String
  payerCode    String?
  phone        String?
  addressLine1 String?
  city         String?
  state        String?
  zip          String?
  active       Boolean     @default(true)
  createdAt    DateTime    @default(now())
  portalName   String?
  parentPayerId String?
  parentPayer  Payer?      @relation("PayerFollows", fields: [parentPayerId], references: [id])
  childPayers  Payer[]     @relation("PayerFollows")
  // Unified "Add Insurance" fields. payerCode doubles as the EDI (claims) payer ID.
  insuranceType         String?
  // The name staff see: made from the insurance name and type, unless someone typed their own.
  displayName           String?
  eraPayerId            String?
  eligibilityPayerId    String?
  alternatePayerId      String?
  alternatePayer        Payer?  @relation("AlternatePayer", fields: [alternatePayerId], references: [id])
  alternateFor          Payer[] @relation("AlternatePayer")
  addressLine2          String?
  fax                   String?
  contactFirstName      String?
  contactLastName       String?
  contactPhone          String?
  contactEmail          String?
  facilityBilling       Boolean @default(false)
  useGroupNpi           Boolean @default(false)
  requiresVisitReview   Boolean @default(false)
  timelyFilingLimit     Int?
  timelyFilingUnit      String  @default("DAYS")
  timelyFilingAlertDays Int?
  // Days the payer allows to appeal a denial, counted from the denial date.
  appealLimitDays       Int?
  // Days after submission with no remittance before a follow-up item opens (nightly job); default 30.
  outstandingDays       Int?
  reimbursementRate     Float?
  notes                 String?
  insurances   Insurance[]
  eligibilityChecks EligibilityCheck[]
  groupEnrollments GroupPayerEnrollment[]
  intakeCases  IntakeCase[]
  claims       Claim[]
  // The plan type this payer name stands for ("Aetna Medicare Advantage" -> MEDICARE_ADVANTAGE).
  planSegment  String?
  plans        PayerPlan[]
}

model BillingProvider {
  id           String      @id @default(cuid())
  practiceId   String
  practice     Practice    @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  name         String
  npi          String?
  taxId        String?
  addressLine1 String?
  city         String?
  state        String?
  zip          String?
  active       Boolean     @default(true)
  createdAt    DateTime    @default(now())
  encounters   Encounter[]
  payerEnrollments GroupPayerEnrollment[]
  taxonomy     String?
  phone        String?
  claims       Claim[]
  documents    GroupDocument[]
}

// Group-level enrollment: one group (billing entity) x one payer line.
model GroupPayerEnrollment {
  id                String          @id @default(cuid())
  billingProviderId String
  billingProvider   BillingProvider @relation(fields: [billingProviderId], references: [id], onDelete: Cascade)
  payerId           String
  payer             Payer           @relation(fields: [payerId], references: [id], onDelete: Cascade)
  planSegment       String          @default("COMMERCIAL")
  planType          String?
  groupStatus       String          @default("NOT_STARTED")
  ediStatus         String          @default("NOT_STARTED")
  eftStatus         String          @default("NOT_STARTED")
  effectiveDate     DateTime?
  payerGroupId      String?
  notes             String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  providerEnrollments ProviderEnrollment[]

  @@unique([billingProviderId, payerId, planSegment])
}

// One record per provider, carrying any mix of roles (referring, clinician,
// rendering, supervising). Only rendering providers are credentialed with payers.
model RenderingProvider {
  billingOverrides PayerBillingOverride[]
  id                    String    @id @default(cuid())
  practiceId            String
  practice              Practice  @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  userId                String?   @unique
  user                  User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  // Display name, kept as "Last, First Middle" from the name parts below.
  name                  String
  title                 String?
  firstName             String?
  middleName            String?
  lastName              String?
  suffix                String?
  // A referring source that is a company or group (hospital, facility, agency) rather than a person: only `name`
  // is kept, and it is never sent on a claim as the referring provider (box 17 must be a person).
  isOrganization        Boolean   @default(false)
  isReferring           Boolean   @default(false)
  // The business development (BD) rep who owns the relationship with this referring physician / source.
  bdOwnerId             String?
  bdOwner               User?     @relation("ReferrerBdOwner", fields: [bdOwnerId], references: [id], onDelete: SetNull)
  isClinician           Boolean   @default(false)
  isRendering           Boolean   @default(false)
  isSupervising         Boolean   @default(false)
  tin                   String?
  addressLine1          String?
  addressLine2          String?
  city                  String?
  state                 String?
  zip                   String?
  phone                 String?
  fax                   String?
  pager                 String?
  email                 String?
  signatureOnFile       Boolean   @default(false)
  primarySupervising    Boolean   @default(false)
  groupName             String?
  acceptsAssignment     Boolean   @default(false)
  requiresSupervision   Boolean   @default(false)
  deaNumber             String?
  ePrescribe            Boolean   @default(false)
  interfaceId           String?
  referredPatients      Patient[] @relation("ReferringProvider")
  credential            String?
  npi                   String?
  taxonomy              String?
  specialty             String?
  licenseNumber         String?
  licenseState          String?
  caqhId                String?
  status                String    @default("ACTIVE")
  termDate              DateTime?
  supervisingProviderId String?
  supervisingProvider   RenderingProvider?  @relation("Supervision", fields: [supervisingProviderId], references: [id])
  supervisees           RenderingProvider[] @relation("Supervision")
  createdAt             DateTime  @default(now())
  enrollments           ProviderEnrollment[]
  documents             ProviderDocument[]
  verificationChecks    PrimarySourceCheck[]
  intakeAssignments     IntakeCase[]         @relation("IntakeProvider")
  supervisedEncounters  Encounter[]          @relation("EncounterSupervisor")
  supervisedAppointments Appointment[]       @relation("AppointmentSupervisor")
  collaboratingAppointments Appointment[]    @relation("AppointmentCollaborator")
  claimsRendering       Claim[]              @relation("ClaimRendering")
  claimsReferring       Claim[]              @relation("ClaimReferring")
  claimsSupervising     Claim[]              @relation("ClaimSupervising")
  claimsOrdering        Claim[]              @relation("ClaimOrdering")
}

// The unit of credentialing work: one provider x one group-payer line (x state).
model ProviderEnrollment {
  id                     String               @id @default(cuid())
  renderingProviderId    String
  renderingProvider      RenderingProvider    @relation(fields: [renderingProviderId], references: [id], onDelete: Cascade)
  groupPayerEnrollmentId String
  groupPayerEnrollment   GroupPayerEnrollment @relation(fields: [groupPayerEnrollmentId], references: [id], onDelete: Cascade)
  state                  String?
  planTypes              String?
  status                 String               @default("NOT_STARTED")
  priority               String               @default("MEDIUM")
  assignedToId           String?
  assignedTo             User?                @relation("EnrollmentAssignee", fields: [assignedToId], references: [id])
  submittedDate          DateTime?
  effectiveDate          DateTime?
  termDate               DateTime?
  revalidationDate       DateTime?
  followUpDate           DateTime?
  payerProviderId        String?
  blockingReason         String?
  nextAction             String?
  approvalLetterPath     String?
  approvalLetterName     String?
  notes                  String?
  statusChangedAt        DateTime             @default(now())
  lastActivityAt         DateTime?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  activities             EnrollmentActivity[]

  @@unique([renderingProviderId, groupPayerEnrollmentId])
}

model EnrollmentActivity {
  id              String             @id @default(cuid())
  enrollmentId    String
  enrollment      ProviderEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  occurredAt      DateTime           @default(now())
  channel         String
  referenceNumber String?
  repName         String?
  note            String
  loggedById      String?
  loggedBy        User?              @relation(fields: [loggedById], references: [id], onDelete: SetNull)
  createdAt       DateTime           @default(now())
}

model ProviderDocument {
  id                  String            @id @default(cuid())
  renderingProviderId String
  renderingProvider   RenderingProvider @relation(fields: [renderingProviderId], references: [id], onDelete: Cascade)
  type                String
  fileName            String
  filePath            String
  mimeType            String
  issueDate           DateTime?
  expiryDate          DateTime?
  supersededAt        DateTime?
  uploadedById        String?
  uploadedBy          User?             @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt           DateTime          @default(now())
}

// Primary source verification / exclusion screening audit trail.
model PrimarySourceCheck {
  id                  String            @id @default(cuid())
  renderingProviderId String
  renderingProvider   RenderingProvider @relation(fields: [renderingProviderId], references: [id], onDelete: Cascade)
  source              String
  result              String
  notes               String?
  checkedAt           DateTime          @default(now())
  checkedById         String?
  checkedBy           User?             @relation(fields: [checkedById], references: [id], onDelete: SetNull)
}

model Allergy {
  id        String  @id @default(cuid())
  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  allergen  String
  reaction  String
  severity  String
}

model Problem {
  id          String    @id @default(cuid())
  patientId   String
  patient     Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  icd10       String
  description String
  status      String    @default("ACTIVE")
  onsetDate   DateTime?
  // Whether coding should take this problem onto the visit's superbill, and how sure the provider is of it.
  sendToSuperbill    Boolean   @default(true)
  verificationStatus String    @default("CONFIRMED")
  resolvedDate       DateTime?
}

model Medication {
  id             String     @id @default(cuid())
  patientId      String
  patient        Patient    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  encounterId    String?
  encounter      Encounter? @relation(fields: [encounterId], references: [id])
  prescriberId   String?
  prescriber     User?      @relation("PrescribedMedications", fields: [prescriberId], references: [id])
  name           String
  sig            String
  status         String     @default("ACTIVE")
  startDate      DateTime   @default(now())
  discontinuedAt DateTime?
}

model Appointment {
  id          String     @id @default(cuid())
  practiceId  String
  practice    Practice   @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  patientId   String
  patient     Patient    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  providerId  String
  provider    User       @relation("ProviderAppointments", fields: [providerId], references: [id])
  locationId  String
  location    Location   @relation(fields: [locationId], references: [id])
  startsAt    DateTime
  endsAt      DateTime
  visitType   String
  status      String     @default("SCHEDULED")
  reason      String?
  createdAt   DateTime   @default(now())
  encounter   Encounter?
  eligibilityChecks EligibilityCheck[]
  placeOfService        String?
  room                  String?
  clinicalStaffId       String?
  clinicalStaff         User?     @relation("AppointmentClinicalStaff", fields: [clinicalStaffId], references: [id], onDelete: SetNull)
  supervisingProviderId String?
  supervisingProvider   RenderingProvider? @relation("AppointmentSupervisor", fields: [supervisingProviderId], references: [id], onDelete: SetNull)
  intakeCaseId          String?
  intakeCase            IntakeCase? @relation(fields: [intakeCaseId], references: [id], onDelete: SetNull)
  seriesId              String?
  conflictNote          String?
  collaboratingProviderId String?
  collaboratingProvider   RenderingProvider? @relation("AppointmentCollaborator", fields: [collaboratingProviderId], references: [id], onDelete: SetNull)
  accountNumber         String?
  resourceId            String?
  resource              SchedulerResource? @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  cancelReason          String?
  cancelledAt           DateTime?
  createdById           String?
  faxes                 Fax[]
  // Patient Connect: confirm / cancel link in reminders.
  confirmToken          String?   @unique
  reminderSentAt        DateTime?
  confirmedAt           DateTime?
  // PATIENT_LINK | STAFF
  confirmedVia          String?
  intakeRequests        IntakeRequest[]
  surveys               SurveyResponse[]
  // Flow board: each status change with its time.
  events                AppointmentEvent[]
  recalls               Recall[]
  // STAFF | ONLINE (patient self-scheduled)
  bookingSource         String?
  bookingNote           String?
  // Copay expected at the visit (from eligibility or the insurance on file).
  copayDueCents         Int?
}

model Encounter {
  educationResources EducationResource[]
  woundTreatments WoundTreatment[]
  id            String        @id @default(cuid())
  practiceId    String
  practice      Practice      @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  patientId     String
  patient       Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  providerId    String
  provider      User          @relation("ProviderEncounters", fields: [providerId], references: [id])
  appointmentId String?       @unique
  appointment   Appointment?  @relation(fields: [appointmentId], references: [id])
  date          DateTime      @default(now())
  type          String        @default("OFFICE")
  // Visit workflow: IN_PROGRESS -> READY_FOR_CDS (or CDS_QUERY) -> READY_FOR_SIGNATURE -> READY_FOR_BILLING -> BILLED,
  // plus holds BILLING_HOLD / HOLD_FOR_AUDIT / DO_NOT_BILL.
  status        String        @default("IN_PROGRESS")
  chiefComplaint String?
  subjective    String?
  objective     String?
  assessment    String?
  plan          String?
  patientStatus String?
  mdmLevel      String?
  hospice       Boolean       @default(false)
  billingProviderId String?
  billingProvider   BillingProvider? @relation(fields: [billingProviderId], references: [id])
  charges       Charge[]
  medications   Medication[]
  vitals        Vitals?
  labOrders     LabOrder[]
  woundAssessments WoundAssessment[]
  diagnoses     EncounterDiagnosis[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  statusChangedAt     DateTime  @default(now())
  placeOfService      String?
  clinicalStaffId     String?
  clinicalStaff       User?     @relation("EncounterClinicalStaff", fields: [clinicalStaffId], references: [id], onDelete: SetNull)
  supervisingProviderId String?
  supervisingProvider RenderingProvider? @relation("EncounterSupervisor", fields: [supervisingProviderId], references: [id], onDelete: SetNull)
  submittedToCdsAt    DateTime?
  cdsQueryNote        String?
  // What the coding team asked CDS to check or correct (cleared when the chart goes back to coding).
  codingQueryNote     String?
  codedById           String?
  codedBy             User?     @relation("EncounterCoder", fields: [codedById], references: [id], onDelete: SetNull)
  codedAt             DateTime?
  finalizedAt         DateTime?
  holdReason          String?
  holdFromStatus      String?
  signatures          EncounterSignature[]
  events              EncounterEvent[]
  // Practice Mate style visit billing status (OPEN, READY_FOR_CLAIM, CLAIM_CREATED_PRIMARY, ...).
  billingStatus       String    @default("OPEN")
  claims              Claim[]
  // Chart workflow (template set) used to document this visit; falls back to the practice default.
  workflowId          String?
  workflow            ChartWorkflow? @relation(fields: [workflowId], references: [id], onDelete: SetNull)
  documents           EncounterDocument[]
  attachments         EncounterAttachment[]
  // Reconciliation done at this visit (medications, allergies, problem list).
  medsReconciledAt      DateTime?
  allergiesReconciledAt DateTime?
  problemsReconciledAt  DateTime?
  reconciledById        String?
  // The patient arrived from another setting of care (hospital discharge, SNF, referral in).
  transferOfCare        Boolean   @default(false)
  // The earlier visit this note was started from ("copy forward").
  copiedFromEncounterId String?
}

model EncounterDiagnosis {
  id          String    @id @default(cuid())
  encounterId String
  encounter   Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  icd10       String
  description String
  priority    Int
  createdAt   DateTime  @default(now())
}

model Vitals {
  id          String    @id @default(cuid())
  encounterId String    @unique
  encounter   Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  // Head circumference, for the growth chart (under 3).
  headCircumferenceCm Float?
  heightCm    Float?
  weightKg    Float?
  tempC       Float?
  heartRate   Int?
  respRate    Int?
  bpSystolic  Int?
  bpDiastolic Int?
  spo2        Int?
  recordedAt  DateTime  @default(now())
}

model LabOrder {
  id           String     @id @default(cuid())
  patientId    String
  patient      Patient    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  encounterId  String
  encounter    Encounter  @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  orderedById  String
  orderedBy    User       @relation("OrderedLabs", fields: [orderedById], references: [id])
  testName     String
  status       String     @default("ORDERED")
  orderedAt    DateTime   @default(now())
  result       LabResult?
}

model LabResult {
  id             String   @id @default(cuid())
  labOrderId     String   @unique
  labOrder       LabOrder @relation(fields: [labOrderId], references: [id], onDelete: Cascade)
  value          String
  unit           String?
  referenceRange String?
  flag           String   @default("NORMAL")
  resultedAt     DateTime @default(now())
}

model Charge {
  id          String     @id @default(cuid())
  practiceId  String
  practice    Practice   @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  encounterId String
  encounter   Encounter  @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  cptCode     String
  description String
  units       Int        @default(1)
  amountCents Int
  modifiers   String?
  diagnosisPointers String?
  placeOfService String  @default("11")
  claimLines  ClaimLine[]
  debridement Debridement?
}

// One claim per visit and payer (primary / secondary / tertiary), carrying every CMS-1500 / 837P field.
model Claim {
  id            String    @id @default(cuid())
  practiceId    String
  practice      Practice  @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  encounterId   String
  encounter     Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  patientId     String
  patient       Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  payerRank     String    @default("PRIMARY")
  insuranceId   String?
  insurance     Insurance? @relation(fields: [insuranceId], references: [id], onDelete: SetNull)
  payerId       String?
  payer         Payer?    @relation(fields: [payerId], references: [id], onDelete: SetNull)
  payerName     String
  formType      String    @default("CMS1500")
  // 1 original, 7 replacement/corrected, 8 void (CLM05-3 / box 22)
  frequencyCode String    @default("1")
  originalReference String?
  replacesClaimId String?
  status        String    @default("DRAFT")

  placeOfService        String?
  billingProviderId     String?
  billingProvider       BillingProvider?   @relation(fields: [billingProviderId], references: [id], onDelete: SetNull)
  renderingProviderId   String?
  renderingProvider     RenderingProvider? @relation("ClaimRendering", fields: [renderingProviderId], references: [id], onDelete: SetNull)
  referringProviderId   String?
  referringProvider     RenderingProvider? @relation("ClaimReferring", fields: [referringProviderId], references: [id], onDelete: SetNull)
  supervisingProviderId String?
  supervisingProvider   RenderingProvider? @relation("ClaimSupervising", fields: [supervisingProviderId], references: [id], onDelete: SetNull)
  orderingProviderId    String?
  orderingProvider      RenderingProvider? @relation("ClaimOrdering", fields: [orderingProviderId], references: [id], onDelete: SetNull)
  serviceLocationId     String?
  serviceLocation       Location?          @relation(fields: [serviceLocationId], references: [id], onDelete: SetNull)

  priorAuthNumber       String?
  referralNumber        String?
  patientAccountNumber  String?
  acceptAssignment      Boolean   @default(true)
  employmentRelated     Boolean   @default(false)
  autoAccident          Boolean   @default(false)
  autoAccidentState     String?
  otherAccident         Boolean   @default(false)
  onsetDate             DateTime?
  initialTreatmentDate  DateTime?
  unableToWorkFrom      DateTime?
  unableToWorkTo        DateTime?
  hospitalFrom          DateTime?
  hospitalTo            DateTime?
  claimNote             String?
  outsideLab            Boolean   @default(false)
  outsideLabChargesCents Int?
  cliaNumber            String?
  delayReasonCode       String?

  billedCents   Int       @default(0)
  paidCents     Int       @default(0)
  adjustedCents Int       @default(0)
  balanceResponsibility String @default("INSURANCE")
  denialReason  String?
  statusNote    String?
  attempt       Int       @default(1)
  submittedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  clearinghouseStatus   String?
  clearinghouseClaimId  String?
  rejectionReason       String?

  lines          ClaimLine[]
  followUps      ClaimFollowUp[]
  // Dunning: how many statements this claim has been on, and when the last went out.
  statementCycle   Int       @default(0)
  lastStatementAt  DateTime?
  diagnoses      ClaimDiagnosis[]
  events         ClaimEvent[]
  applications   PaymentApplication[]
  statementLines StatementLine[]
  denials        ClaimDenial[]

  @@index([practiceId, status])
  @@index([encounterId])
}

model SuperbillTemplate {
  id         String   @id @default(cuid())
  practiceId String
  practice   Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  name       String
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  items      SuperbillTemplateItem[]
}

model SuperbillTemplateItem {
  id          String            @id @default(cuid())
  templateId  String
  template    SuperbillTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  cptCode     String
  description String
  modifiers   String?
  amountCents Int
  order       Int               @default(0)
}

model Statement {
  id         String          @id @default(cuid())
  practiceId String
  practice   Practice        @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  patientId  String
  patient    Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  totalCents Int
  createdAt  DateTime        @default(now())
  lines      StatementLine[]
  // The dunning cycle: which notice this is, how it went out, and the run it belongs to.
  runId        String?
  run          StatementRun?   @relation(fields: [runId], references: [id], onDelete: SetNull)
  cycle        Int             @default(1)
  channel      String          @default("PAPER")
  status       String          @default("GENERATED")
  sentAt       DateTime?
  message      String?
  deliveryNote String?
}

// One statement run: who ran it, how many statements, the total.
model StatementRun {
  id          String      @id @default(cuid())
  practiceId  String
  practice    Practice    @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  createdById String?
  createdAt   DateTime    @default(now())
  status      String      @default("GENERATED")
  count       Int         @default(0)
  totalCents  Int         @default(0)
  note        String?
  statements  Statement[]
}

// A patient's agreed instalments; active plans pause statements and follow-ups.
model PaymentPlan {
  id              String                   @id @default(cuid())
  practiceId      String
  practice        Practice                 @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  patientId       String
  patient         Patient                  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  totalCents      Int
  installmentCents Int
  frequency       String                   @default("MONTHLY")
  method          String                   @default("MANUAL")
  cardRef         String?
  nextDueAt       DateTime?
  paidCents       Int                      @default(0)
  missed          Int                      @default(0)
  status          String                   @default("ACTIVE")
  note            String?
  createdById     String?
  createdAt       DateTime                 @default(now())
  completedAt     DateTime?
  installments    PaymentPlanInstallment[]

  @@index([practiceId, status])
}

model PaymentPlanInstallment {
  id         String      @id @default(cuid())
  planId     String
  plan       PaymentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  dueAt      DateTime
  amountCents Int
  status     String      @default("DUE")
  paidAt     DateTime?
  receiptId  String?
}

// An account that finished the statement cycle: what the practice decided and, when referred, which agency.
model CollectionsCase {
  id           String    @id @default(cuid())
  practiceId   String
  practice     Practice  @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  patientId    String
  patient      Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  balanceCents Int
  status       String    @default("REVIEW")
  agency       String?
  referredAt   DateTime?
  note         String?
  outcome      String?
  createdById  String?
  decidedById  String?
  decidedAt    DateTime?
  closedAt     DateTime?
  createdAt    DateTime  @default(now())

  @@index([practiceId, status])
}

model StatementLine {
  id           String    @id @default(cuid())
  statementId  String
  statement    Statement @relation(fields: [statementId], references: [id], onDelete: Cascade)
  claimId      String
  claim        Claim     @relation(fields: [claimId], references: [id], onDelete: Cascade)
  balanceCents Int
}

model Deposit {
  id             String   @id @default(cuid())
  practiceId     String
  practice       Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  payerType      String
  payerName      String
  paymentMethod  String
  checkNumber    String?
  totalCents     Int
  unappliedCents Int
  note           String?
  postedAt       DateTime @default(now())
  applications   PaymentApplication[]
  // Front-desk collections (copays, prepayments) waiting to be applied to the patient's claims.
  patientId      String?
  // Bank side: OPEN -> DEPOSITED (on a slip) -> RECONCILED (matched to a bank statement credit).
  status         String    @default("OPEN")
  depositDate    DateTime?
  bankAccount    String?
  bankRef        String?
  reconciledAt   DateTime?
}

// A closed month: who closed it, the frozen numbers, and any reopening.
model PeriodClose {
  id           String    @id @default(cuid())
  practiceId   String
  practice     Practice  @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  period       String
  closedAt     DateTime  @default(now())
  closedById   String?
  note         String?
  snapshot     String?
  reopenedAt   DateTime?
  reopenedById String?
  reopenReason String?

  @@unique([practiceId, period])
}

// One bank statement import and what it could not match.
model BankImport {
  id           String   @id @default(cuid())
  practiceId   String
  practice     Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  importedById String?
  createdAt    DateTime @default(now())
  lines        Int      @default(0)
  matched      Int      @default(0)
  unmatched    String   @default("[]")
}

model PaymentApplication {
  id          String   @id @default(cuid())
  depositId   String
  deposit     Deposit  @relation(fields: [depositId], references: [id], onDelete: Cascade)
  claimId     String
  claim       Claim    @relation(fields: [claimId], references: [id], onDelete: Cascade)
  amountCents Int
  type        String   @default("PAYMENT")
  postedAt    DateTime @default(now())
}

model Wound {
  treatments WoundTreatment[]
  id          String            @id @default(cuid())
  practiceId  String
  practice    Practice          @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  patientId   String
  patient     Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  label       String
  location    String
  etiology    String
  onsetDate   DateTime?
  status      String            @default("ACTIVE")
  healedDate  DateTime?
  createdAt   DateTime          @default(now())
  assessments WoundAssessment[]
}

model WoundAssessment {
  id           String    @id @default(cuid())
  woundId      String
  wound        Wound     @relation(fields: [woundId], references: [id], onDelete: Cascade)
  encounterId  String
  encounter    Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  assessedAt   DateTime  @default(now())

  lengthCm         Float?
  widthCm          Float?
  depthCm          Float?
  areaCm2          Float?
  underminingCm    Float?
  underminingClock String?
  tunnelingCm      Float?
  tunnelingClock   String?

  stage String?

  granulationPct Int?
  sloughPct      Int?
  escharPct      Int?
  epithelialPct  Int?

  exudateAmount String?
  exudateType   String?

  periwoundSkin String?
  odor          Boolean @default(false)
  painLevel     Int?

  pushExudateAmount    String?
  pushTissueType       String?
  pushSurfaceAreaScore Int?
  pushExudateScore     Int?
  pushTissueScore      Int?
  pushTotal            Int?

  bwatItems String?
  bwatTotal Int?

  photoUrl String?
  notes    String?

  assessedById String
  assessedBy   User   @relation("WoundAssessor", fields: [assessedById], references: [id])

  debridement Debridement?

  createdAt DateTime @default(now())
}

model Debridement {
  id                String          @id @default(cuid())
  woundAssessmentId String          @unique
  woundAssessment   WoundAssessment @relation(fields: [woundAssessmentId], references: [id], onDelete: Cascade)
  method            String
  tissueRemoved     String?
  cptCode           String?
  chargeId          String?         @unique
  charge            Charge?         @relation(fields: [chargeId], references: [id])
  performedById     String
  performedBy       User            @relation("DebridementPerformer", fields: [performedById], references: [id])
  createdAt         DateTime        @default(now())
}

model EligibilityCheck {
  id            String       @id @default(cuid())
  practiceId    String
  practice      Practice     @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  patientId     String
  patient       Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  payerId       String
  payer         Payer        @relation(fields: [payerId], references: [id])
  status        String
  planName      String?
  copayCents    Int?
  coinsurancePercent Int?
  deductibleRemainingCents Int?
  outOfPocketRemainingCents Int?
  payerMessage  String?
  checkedAt     DateTime     @default(now())
  insuranceId   String?
  checkedById   String?
  // Gateway case the check was run for, and the full payer response.
  intakeCaseId  String?
  // JSON: subscriber, plan, deductible, out-of-pocket and per-service benefits as the payer returned them.
  benefits      String?
  raw           String?
}

// Every VOB decision is kept so the gateway can learn what each payer / plan usually ends in,
// and tell data entry whether a new patient can be taken without waiting for the VOB team.
model VobDecision {
  id               String     @id @default(cuid())
  practiceId       String
  practice         Practice   @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  caseId           String
  case             IntakeCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  payerId          String?
  planSegment      String?
  planName         String?
  providerId       String?
  // IN_NETWORK | PENDING | NOT_ENROLLED at the time of the decision
  network          String?
  // APPROVED_ALL | APPROVED_LIMITED | DENIED | HOLD
  decision         String
  authRequired     Boolean    @default(false)
  referralRequired Boolean    @default(false)
  denyReason       String?
  note             String?
  // VOB (decided by the VOB team) | DIRECT (taken by data entry on the system's suggestion)
  source           String     @default("VOB")
  decidedById      String?
  createdAt        DateTime   @default(now())

  @@index([practiceId, payerId, planSegment])
}

// Patient Gateway: the pre-scheduling case every new referral moves through.
// Team 1 (data entry) -> Team 2 (verification: EVBV, prior auth, PCC referral) -> Team 3 (scheduling).
model IntakeCase {
  id                    String    @id @default(cuid())
  practiceId            String
  practice              Practice  @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  patientId             String
  patient               Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  // DATA_ENTRY | VERIFICATION | AUTH_PENDING | PCC_REFERRAL | SCHEDULING | SCHEDULED | CLOSED
  stage                 String    @default("DATA_ENTRY")
  priority              String    @default("NORMAL")
  ownerId               String?
  owner                 User?     @relation("IntakeOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  holdReason            String?
  stageChangedAt        DateTime  @default(now())

  // Team 1: referral source
  referralDate          DateTime?
  referralSourceType    String?
  referralSourceName    String?
  referralContactName   String?
  referralContactPhone  String?
  referralContactFax    String?
  servicesRequested     String?
  referralNotes         String?
  dataEntryCompletedAt  DateTime?
  // Details data entry is waiting on from the BD / referral source.
  infoRequestedAt       DateTime?
  infoRequestedFrom     String?
  infoRequestNote       String?
  // Clearinghouse eligibility run by data entry, and their sign-off that the entered data was checked by hand.
  eligibilityCheckId    String?
  eligibilityCheckedAt  DateTime?
  dataVerifiedAt        DateTime?
  dataVerifiedById      String?
  // Consent forms sent to the patient for e-signature.
  consentRequestId      String?
  consentsSentAt        DateTime?

  // Team 2: eligibility & benefits
  payerId               String?
  payer                 Payer?    @relation(fields: [payerId], references: [id], onDelete: SetNull)
  planSegment           String?
  memberId              String?
  eligibilityStatus     String    @default("PENDING")
  coverageEffectiveDate DateTime?
  coverageTermDate      DateTime?
  copayCents            Int?
  deductibleCents       Int?
  deductibleMetCents    Int?
  coinsurancePercent    Int?
  outOfPocketRemainingCents Int?
  verifiedAt            DateTime?
  verifiedWith          String?
  verificationReference String?
  benefitsNotes         String?
  // Prior authorization
  authRequired          String    @default("UNKNOWN")
  authStatus            String    @default("NOT_REQUIRED")
  authNumber            String?
  authSubmittedAt       DateTime?
  authDecisionAt        DateTime?
  authStartDate         DateTime?
  authEndDate           DateTime?
  authVisitsApproved    Int?
  authNotes             String?
  // Referral from the PCP, worked by the PCC team
  referralRequired      String    @default("UNKNOWN")
  referralStatus        String    @default("NOT_REQUIRED")
  referralNumber        String?
  pccSentAt             DateTime?
  pccNotes              String?
  // Rendering provider who will see the patient; drives the credentialing check.
  assignedProviderId    String?
  assignedProvider      RenderingProvider? @relation("IntakeProvider", fields: [assignedProviderId], references: [id], onDelete: SetNull)
  networkOverrideNote   String?
  approvedForServiceAt  DateTime?
  // VOB decision: APPROVED_ALL | APPROVED_LIMITED (E&M and debridements only) | DENIED | HOLD (auth / referral)
  vobDecision           String?
  vobDecisionAt         DateTime?
  vobDecisionById       String?
  vobDecisionNote       String?
  vobDenyReason         String?
  // VOB | DIRECT (data entry took the patient on the learned suggestion)
  vobDecisionSource     String?
  vobDecisions          VobDecision[]

  // Team 3: scheduling
  consentTreatment      Boolean   @default(false)
  consentHipaa          Boolean   @default(false)
  consentFinancial      Boolean   @default(false)
  consentAssignment     Boolean   @default(false)
  consentsCompletedAt   DateTime?
  pcpName               String?
  pcpPhone              String?
  pcpFax                String?
  referralAppStatus     String    @default("NOT_STARTED")
  scheduledAt           DateTime?
  // FOLLOW_UP | ACTIVE | INACTIVE | LIMITED
  careStatus            String?
  providerBrief         String?
  closedReason          String?

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  activities            IntakeActivity[]
  documents             PatientDocument[]

  @@index([practiceId, stage])
  appointments          Appointment[]
}

model IntakeActivity {
  id         String     @id @default(cuid())
  caseId     String
  case       IntakeCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  stage      String
  action     String
  note       String?
  createdAt  DateTime   @default(now())
}

// A provider's attestation and signature on a visit. The rendering provider always signs; a supervising
// physician co-signs when the visit was performed under supervision.
model EncounterSignature {
  id          String    @id @default(cuid())
  encounterId String
  encounter   Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  role        String    // PROVIDER | SUPERVISOR
  signedName  String
  attestation String
  signedAt    DateTime  @default(now())

  @@unique([encounterId, role])
  // Snapshot of the signer's signature image at the moment of signing.
  signatureImage String?
}

// Status history of a visit as it moves between the provider, CDS and billing.
model EncounterEvent {
  id          String    @id @default(cuid())
  encounterId String
  encounter   Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  fromStatus  String?
  toStatus    String
  note        String?
  createdAt   DateTime  @default(now())
}

// Service line (box 24) — copied from the visit's charges when the claim is created, then edited on the claim.
model ClaimLine {
  id           String   @id @default(cuid())
  claimId      String
  claim        Claim    @relation(fields: [claimId], references: [id], onDelete: Cascade)
  chargeId     String?
  charge       Charge?  @relation(fields: [chargeId], references: [id], onDelete: SetNull)
  lineNumber   Int
  dosFrom      DateTime
  dosTo        DateTime
  placeOfService String
  emergency    Boolean  @default(false)
  cptCode      String
  modifiers    String?
  // Diagnosis pointer letters, e.g. "A,B" (box 24E)
  pointers     String
  units        Float    @default(1)
  chargeCents  Int
  ndcCode      String?
  ndcQuantity  Float?
  ndcUnit      String?
  lineNote     String?
  paidCents    Int      @default(0)
  adjustedCents Int     @default(0)
}

// Box 21 diagnosis codes A–L, in order.
model ClaimDiagnosis {
  id          String @id @default(cuid())
  claimId     String
  claim       Claim  @relation(fields: [claimId], references: [id], onDelete: Cascade)
  sequence    Int
  icd10       String
  description String?

  @@unique([claimId, sequence])
}

// Claim change log: field edits, status changes, submissions.
model ClaimEvent {
  id        String   @id @default(cuid())
  claimId   String
  claim     Claim    @relation(fields: [claimId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  field     String?
  oldValue  String?
  newValue  String?
  note      String?
  createdAt DateTime @default(now())
}

// One row per payer denial of a claim, kept after the claim is fixed so denial and overturn rates can be reported.
model ClaimDenial {
  id             String    @id @default(cuid())
  practiceId     String
  practice       Practice  @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  claimId        String
  claim          Claim     @relation(fields: [claimId], references: [id], onDelete: Cascade)
  deniedAt       DateTime  @default(now())
  // ERA | MANUAL
  source         String    @default("MANUAL")
  // CAS group (CO, PR, OA, PI) and claim adjustment reason code (CARC); remark codes (RARC) comma separated.
  groupCode      String?
  code           String?
  remarks        String?
  // ELIGIBILITY | COB | AUTHORIZATION | CODING | INFORMATION | DUPLICATE | TIMELY_FILING | MEDICAL_NECESSITY | NON_COVERED | CREDENTIALING | OTHER
  category       String    @default("OTHER")
  reason         String
  amountCents    Int       @default(0)
  // OPEN | APPEALED | RESOLVED
  status         String    @default("OPEN")
  // RESUBMITTED | CORRECTED | OVERTURNED | PAID | PATIENT | WRITTEN_OFF | VOIDED
  resolution     String?
  resolvedAt     DateTime?
  recoveredCents Int       @default(0)
  ownerId        String?
  followUpAt     DateTime?
  workNote       String?
  appealDueAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  appeals        ClaimAppeal[]

  @@index([practiceId, status])
  @@index([claimId])
}

model ClaimAppeal {
  id               String      @id @default(cuid())
  practiceId       String
  denialId         String
  denial           ClaimDenial @relation(fields: [denialId], references: [id], onDelete: Cascade)
  claimId          String
  // 1 first-level, 2 second-level, 3 external review
  level            Int         @default(1)
  // DRAFT | FILED | OVERTURNED | PARTIAL | UPHELD | WITHDRAWN
  status           String      @default("DRAFT")
  letterBody       String
  dueAt            DateTime?
  filedAt          DateTime?
  // FAX | MAIL | PORTAL
  filedVia         String?
  faxId            String?
  letterDocumentId String?
  payerReference   String?
  decisionAt       DateTime?
  recoveredCents   Int         @default(0)
  outcomeNote      String?
  createdById      String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([practiceId, status])
}

// Practice code lists for the superbill: ICD-10 favorites and CPT/HCPCS codes with fees.
model PracticeCode {
  id          String   @id @default(cuid())
  practiceId  String
  practice    Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  // ICD10 | CPT
  type        String
  code        String
  description String
  category    String?
  feeCents    Int?
  modifiers   String?
  favorite    Boolean  @default(true)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@unique([practiceId, type, code])
}

// ---- Chart templates & workflows (Documentation settings) ----

// A chart document: either a built-in chart section (CC/HPI, vitals, wounds, superbill...) or a
// designable form whose fields are defined in `fields` (JSON FieldDef[]).
model DocumentTemplate {
  // Specialty pack this belongs to; null = general (shown whatever packs are on).
  specialty  String?
  id          String   @id @default(cuid())
  practiceId  String
  practice    Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  key         String
  name        String
  description String?
  // DOCUMENTATION | PROCEDURE | PROGRESS | BILLING | ADDITIONAL
  section     String   @default("ADDITIONAL")
  // BUILTIN | FORM
  kind        String   @default("FORM")
  builtin     String?
  // Completed once per open wound (e.g. treatment notes) instead of once per visit.
  perWound    Boolean  @default(false)
  // STAFF (chart documents) | PATIENT (Patient Connect intake forms)
  audience    String   @default("STAFF")
  fields      String   @default("[]")
  standard    Boolean  @default(false)
  signatureRequired Boolean @default(false)
  critical    Boolean  @default(false)
  inProgressNote Boolean @default(true)
  noteOrder   Int      @default(100)
  active      Boolean  @default(true)
  sortOrder   Int      @default(100)
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  steps       ChartWorkflowStep[]
  documents   EncounterDocument[]

  @@unique([practiceId, key])
}

// Which documents a visit type charts, in what order, and which must be complete to finalize.
model ChartWorkflow {
  // Specialty pack this belongs to; null = general (shown whatever packs are on).
  specialty  String?
  id          String   @id @default(cuid())
  practiceId  String
  practice    Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  name        String
  description String?
  // Comma-separated appointment visit types that use this workflow.
  visitTypes  String?
  isDefault   Boolean  @default(false)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  steps       ChartWorkflowStep[]
  encounters  Encounter[]
}

model ChartWorkflowStep {
  id          String           @id @default(cuid())
  workflowId  String
  workflow    ChartWorkflow    @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  templateId  String
  template    DocumentTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  sortOrder   Int              @default(0)
  requiredToFinalize Boolean   @default(false)

  @@unique([workflowId, templateId])
}

// A completed (or draft) form on a visit. woundKey is the wound id for per-wound forms, "" otherwise.
model EncounterDocument {
  id            String           @id @default(cuid())
  encounterId   String
  encounter     Encounter        @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  templateId    String
  template      DocumentTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  woundKey      String           @default("")
  data          String           @default("{}")
  // DRAFT | COMPLETE
  status        String           @default("DRAFT")
  score         Int?
  templateVersion Int            @default(1)
  completedById String?
  completedBy   User?            @relation("DocumentCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  completedAt   DateTime?
  signedById    String?
  signedBy      User?            @relation("DocumentSignedBy", fields: [signedById], references: [id], onDelete: SetNull)
  signedName    String?
  signedAt      DateTime?
  signatureImage String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([encounterId, templateId, woundKey])
}

// Scans and test result files attached to a visit.
model EncounterAttachment {
  id           String    @id @default(cuid())
  encounterId  String
  encounter    Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  // SCAN | TEST_RESULT | PHOTO | OTHER
  category     String    @default("SCAN")
  title        String
  filePath     String
  fileName     String
  mimeType     String
  uploadedById String?
  uploadedBy   User?     @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
}

// A printable combination of chart documents (e.g. "Progress Note + Physician Orders").
model DocumentationView {
  id          String   @id @default(cuid())
  practiceId  String
  practice    Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  name        String
  description String?
  // JSON array of parts: "facesheet", "note", "wounds", "superbill", "signatures", "documents", or "doc:<templateKey>".
  parts       String   @default("[]")
  active      Boolean  @default(true)
  sortOrder   Int      @default(100)
  createdAt   DateTime @default(now())
}

// Facility setup - general settings (claim pay-to, statement addresses, billing rules, clearinghouse).
model PracticeSettings {
  // Specialty packs turned on (comma list, see src/lib/specialties.ts): WOUND_CARE, PRIMARY_CARE...
  specialties      String   @default("WOUND_CARE")
  id          String   @id @default(cuid())
  practiceId  String   @unique
  practice    Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  payToName     String?
  payToAddress1 String?
  payToAddress2 String?
  payToCity     String?
  payToState    String?
  payToZip      String?
  payeeName     String?
  payeeAddress1 String?
  payeeAddress2 String?
  payeeCity     String?
  payeeState    String?
  payeeZip      String?
  remitName     String?
  remitAddress1 String?
  remitAddress2 String?
  remitCity     String?
  remitState    String?
  remitZip      String?
  physicalName     String?
  physicalAddress1 String?
  physicalAddress2 String?
  physicalCity     String?
  physicalState    String?
  physicalZip      String?
  yearEndMonth     Int      @default(12)
  // ACCOUNT (billing provider on the claim) | PRACTICE
  taxIdSource      String   @default("ACCOUNT")
  practiceTaxId    String?
  useVisitNumbers  Boolean  @default(false)
  cutoffDay        Int?
  cutoffLastDay    Boolean  @default(false)
  // SAME | FOLLOWING
  cutoffMonth      String   @default("FOLLOWING")
  billingPhone     String?
  allowZeroChargeClaims Boolean @default(false)
  includeEmergencyFlag  Boolean @default(false)
  allowEdiVoid          Boolean @default(true)
  enableClaimRules      Boolean @default(true)
  suppressSecondaryEraAdjustments Boolean @default(false)
  holdClaimsForCredentialing Boolean @default(false)
  // Workflow rules (Practice setup → Workflow rules): each team step depends on the one before it.
  // Booking needs the Gateway case to have reached scheduling (or no case at all).
  bookingRequiresGateway     Boolean @default(false)
  // Booking needs the provider to be credentialed with the patient's primary payer.
  bookingChecksCredentialing Boolean @default(false)
  // A chart can be started only after the front desk has checked the patient in.
  chartRequiresCheckIn       Boolean @default(false)
  // A VOB decision limited to E&M and debridement blocks other services on the claim.
  enforceVobScope            Boolean @default(false)
  // No self-review: nobody CDS-reviews or codes a visit they documented, or codes one they reviewed.
  separateDuties             Boolean @default(true)
  clearinghouse    String   @default("MOCK")
  // Accounting period close: no deposit may be posted dated on or before this day.
  closedThrough    DateTime?
  // Read uploaded patient documents with Claude (sends the file to Anthropic) instead of on-device OCR.
  documentAiEnabled Boolean @default(false)
  // Electronic fax line shown on the Faxing page; MOCK until a fax service is connected.
  faxNumber        String?
  faxProvider      String   @default("MOCK")
  updatedAt        DateTime @updatedAt
  // Run eligibility for the next business day's appointments every night.
  eligibilityAuto Boolean @default(false)
  // Days without a consult note before an outgoing referral needs follow-up.
  referralFollowUpDays Int @default(30)
  // Thresholds & timers (Practice setup): small-balance write-off default, and how far ahead an appeal deadline is flagged.
  smallBalanceCents    Int @default(500)
  // A patient balance at or above this raises a computed "collect balance" alert (0 = off).
  alertBalanceCents    Int @default(10000)
  // An ERA paying under the charge-schedule allowable by more than this opens an underpayment follow-up.
  underpaymentToleranceCents Int @default(500)
  // Statement cycle: days between notices, notices before collections, minimum balance, the message per notice.
  statementMinDays   Int     @default(28)
  statementCycles    Int     @default(3)
  statementMinCents  Int     @default(500)
  statementMessage1  String?
  statementMessage2  String?
  statementMessage3  String?
  appealAlertDays      Int @default(14)
}

// Patient documents uploaded by the data entry team (referrals, face sheets, insurance cards...).
// They are read (text layer, OCR or Claude), reviewed, renamed, and their details applied to the patient.
model PatientDocument {
  id            String      @id @default(cuid())
  practiceId    String
  practice      Practice    @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  patientId     String?
  patient       Patient?    @relation(fields: [patientId], references: [id], onDelete: SetNull)
  intakeCaseId  String?
  intakeCase    IntakeCase? @relation(fields: [intakeCaseId], references: [id], onDelete: SetNull)
  // Display name (renameable) and the name it was uploaded with.
  name          String
  originalName  String
  filePath      String
  mimeType      String
  sizeBytes     Int
  // REFERRAL | FACE_SHEET | INSURANCE_CARD | PHOTO_ID | H_AND_P | ORDERS | MEDICATION_LIST | LAB_RESULTS | CONSENT | OTHER
  docType       String      @default("OTHER")
  // PROCESSING | READ | FAILED | APPLIED
  status        String      @default("PROCESSING")
  // TEXT (PDF text layer) | OCR | CLAUDE
  readMethod    String?
  pageCount     Int?
  extractedText String?
  // JSON: { docType, fields: { key: { value, confidence, source } }, notes }
  extraction    String?
  error         String?
  uploadedById  String?
  uploadedBy    User?       @relation("PatientDocumentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  reviewedById  String?
  reviewedBy    User?       @relation("PatientDocumentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt    DateTime?
  appliedAt     DateTime?
  // Visit the scan belongs to (optional).
  encounterId   String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([practiceId, status])
}

// ---- Scheduler admin (Settings -> Scheduling) ----

// Encounter / visit types with their default length and calendar colours.
model VisitType {
  // Specialty pack this belongs to; null = general (shown whatever packs are on).
  specialty  String?
  id         String   @id @default(cuid())
  practiceId String
  practice   Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  code       String
  name       String
  durationMin Int?
  // Non-billable interactions (communication log, data entry, provider orders) don't create claims.
  billable   Boolean  @default(true)
  textColor  String   @default("#ffffff")
  bgColor    String   @default("#2f5fa8")
  active     Boolean  @default(true)
  sortOrder  Int      @default(100)
  createdAt  DateTime @default(now())

  @@unique([practiceId, code])
  // Patients can book this type themselves on the online booking page.
  onlineBooking Boolean @default(false)
  // Offer the wound photo analyzer (AI measurements) at visits of this type.
  woundAnalytics Boolean @default(true)
}

model SchedulerSettings {
  id          String   @id @default(cuid())
  practiceId  String   @unique
  practice    Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  // NONE | TYPE | STATUS | PHYSICIAN
  colorMode   String   @default("STATUS")
  // JSON { STATUS_KEY: { text, bg } } and { userId: { text, bg } }
  statusColors    String @default("{}")
  physicianColors String @default("{}")
  // JSON array of field keys shown in the visit preview on the schedule.
  previewFields   String @default("[\"primaryInsurance\",\"authCount\",\"authRemaining\",\"authStart\",\"authEnd\",\"copay\"]")
  defaultLocationId String?
  showWeekends      Boolean @default(false)
  showPosDropdown   Boolean @default(true)
  autoCheckIn       Boolean @default(false)
  autoCheckInMinutes Int    @default(15)
  showCapacityView  Boolean @default(true)
  // CURRENT (now, rounded to the slot) | FIXED (startTimeFixed)
  startTimeMode     String  @default("FIXED")
  startTimeFixed    String  @default("07:30")
  showConflicts     Boolean @default(true)
  allowCrossSiteConflicts Boolean @default(false)
  defaultAuthorizations   Boolean @default(true)
  updatedAt   DateTime @updatedAt
}

model CancellationReason {
  id         String   @id @default(cuid())
  practiceId String
  practice   Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  name       String
  active     Boolean  @default(true)
  sortOrder  Int      @default(100)
  createdAt  DateTime @default(now())

  @@unique([practiceId, name])
}

// Saved calendar filters ("filter sets") the schedule can switch between.
model CalendarFilterSet {
  id          String   @id @default(cuid())
  practiceId  String
  practice    Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  name        String
  description String?
  locationId  String?
  providerIds String?
  visitTypes  String?
  view        String   @default("day")
  createdAt   DateTime @default(now())
}

// Bookable equipment/rooms with a limit of simultaneous visits (e.g. MIST ultrasound units).
model SchedulerResource {
  id         String   @id @default(cuid())
  practiceId String
  practice   Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  name       String
  maxUnits   Int      @default(1)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  appointments Appointment[]
}

// Announcements shown to every user while active (Settings -> System messages).
model SystemMessage {
  id          String    @id @default(cuid())
  practiceId  String
  practice    Practice  @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  title       String
  message     String
  // INFO | WARNING | URGENT
  level       String    @default("INFO")
  active      Boolean   @default(true)
  activeFrom  DateTime?
  activeTo    DateTime?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// Inbound and outbound faxes.
model Fax {
  id            String     @id @default(cuid())
  practiceId    String
  practice      Practice   @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  // INBOUND | OUTBOUND
  direction     String
  // INBOUND: RECEIVED | FILED ; OUTBOUND: QUEUED | PROCESSING | SUCCESS | FAILURE | NOT_SENT
  status        String
  faxNumber     String
  recipientName String?
  pages         Int?
  // Outbound: documentation view sent (name) and the visit it came from.
  contentType   String?
  viewId        String?
  encounterId   String?
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  patientId     String?
  documentId    String?
  notes         String?
  error         String?
  providerRef   String?
  userId        String?
  sentAt        DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([practiceId, direction, createdAt])
}

// ---- Patient Connect (patient-facing intake, reminders, surveys) ----

// A bundle of patient-facing forms sent together (e.g. "New patient packet").
model IntakePacket {
  id          String   @id @default(cuid())
  practiceId  String
  practice    Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  name        String
  description String?
  // JSON array of DocumentTemplate keys in order.
  templateKeys String  @default("[]")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  requests    IntakeRequest[]
  rules       AutomationRule[]
  kioskLinks  KioskLink[]
}

// A packet sent to one patient (or started at a kiosk by a new patient).
model IntakeRequest {
  id            String       @id @default(cuid())
  practiceId    String
  practice      Practice     @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  patientId     String?
  patient       Patient?     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  packetId      String
  packet        IntakePacket @relation(fields: [packetId], references: [id], onDelete: Cascade)
  token         String       @unique
  // SENT | OPENED | IN_PROGRESS | COMPLETED | EXPIRED | CANCELLED
  status        String       @default("SENT")
  // SMS | EMAIL | LINK | KIOSK
  channel       String       @default("LINK")
  sentTo        String?
  expiresAt     DateTime
  openedAt      DateTime?
  completedAt   DateTime?
  verifyAttempts Int         @default(0)
  lockedUntil   DateTime?
  // Hash of the browser session allowed in after the DOB check.
  sessionHash   String?
  // JSON { templateKey: { fieldId: value } }
  answers       String       @default("{}")
  currentStep   Int          @default(0)
  documentId    String?
  kioskLinkId   String?
  reminderCount Int          @default(0)
  lastReminderAt DateTime?
  ruleId        String?
  createdById   String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([practiceId, status])
}

// Every text / email CareHub sends (or would send, with the test sender).
model MessageLog {
  id            String   @id @default(cuid())
  practiceId    String
  practice      Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  patientId     String?
  appointmentId String?
  requestId     String?
  // SMS | EMAIL
  channel       String
  to            String
  subject       String?
  body          String
  // INTAKE | REMINDER | SURVEY | OTHER
  kind          String
  // SENT | FAILED
  status        String
  provider      String   @default("MOCK")
  error         String?
  ruleId        String?
  createdById   String?
  createdAt     DateTime @default(now())

  @@index([practiceId, createdAt])
}

model AutomationRule {
  id          String   @id @default(cuid())
  practiceId  String
  practice    Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  name        String
  // INTAKE_PACKET | REMINDER | SURVEY
  kind        String
  // Hours before the appointment (INTAKE_PACKET, REMINDER) or after it (SURVEY).
  offsetHours Int      @default(48)
  // SMS | EMAIL | BOTH
  channel     String   @default("BOTH")
  packetId    String?
  packet      IntakePacket? @relation(fields: [packetId], references: [id], onDelete: SetNull)
  onlyNewPatients Boolean @default(false)
  // Comma-separated visit type codes; empty = all.
  visitTypes  String?
  messageTemplate String?
  active      Boolean  @default(true)
  lastRunAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SurveyResponse {
  id            String       @id @default(cuid())
  practiceId    String
  practice      Practice     @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  patientId     String
  patient       Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  token         String       @unique
  score         Int?
  comment       String?
  sentAt        DateTime     @default(now())
  respondedAt   DateTime?
}

// QR / link for walk-in self-registration at a site (starts a packet without a chart).
model KioskLink {
  id          String       @id @default(cuid())
  practiceId  String
  practice    Practice     @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  name        String
  token       String       @unique
  packetId    String
  packet      IntakePacket @relation(fields: [packetId], references: [id], onDelete: Cascade)
  locationId  String?
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
}

// Patient-facing branding and messaging.
model ConnectSettings {
  id            String   @id @default(cuid())
  practiceId    String   @unique
  practice      Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  displayName   String?
  brandColor    String   @default("#171342")
  accentColor   String   @default("#4f9c60")
  // Small logo as a PNG/JPEG data URL.
  logo          String?
  welcomeText   String?
  supportPhone  String?
  // MOCK (test sender) | TWILIO | SENDGRID
  smsProvider   String   @default("MOCK")
  emailProvider String   @default("MOCK")
  linkDays      Int      @default(14)
  // Spanish forms offered when a form has a Spanish version (future).
  languages     String   @default("en")
  updatedAt     DateTime @updatedAt
  // Online self-scheduling
  bookingEnabled     Boolean @default(false)
  bookingToken       String? @unique
  bookingApproval    Boolean @default(true)
  bookingNewPatients Boolean @default(true)
  bookingLeadHours   Int     @default(24)
  bookingWindowDays  Int     @default(30)
  bookingMessage     String?
  // Online bill pay: TEST (simulated) | STRIPE (hosted checkout)
  paymentsEnabled    Boolean @default(false)
  paymentProvider    String  @default("TEST")
  // Reminder, recall and survey texts only go to patients whose consent to text is recorded as YES.
  requireTextConsent Boolean @default(true)
}

// ---- ERA / 835 remittance ----

model EraFile {
  id            String   @id @default(cuid())
  practiceId    String
  practice      Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  fileName      String
  payerName     String
  payerId       String?
  payeeName     String?
  payeeNpi      String?
  // BPR04: ACH | CHK | NON (no payment)
  paymentMethod String
  // TRN02 check / EFT trace number
  traceNumber   String?
  paymentDate   DateTime?
  totalCents    Int
  // IMPORTED | POSTED | PARTIAL
  status        String   @default("IMPORTED")
  depositId     String?
  raw           String
  importedById  String?
  postedAt      DateTime?
  createdAt     DateTime @default(now())
  claims        EraClaim[]

  @@index([practiceId, createdAt])
  // PLB provider-level adjustments (interest, recoupments, withholds): positive reduces the payment.
  plbCents      Int      @default(0)
  plbDetail     String   @default("[]")
}

model EraClaim {
  id               String   @id @default(cuid())
  eraFileId        String
  eraFile          EraFile  @relation(fields: [eraFileId], references: [id], onDelete: Cascade)
  claimId          String?
  // CLP01 patient control number as sent on the claim
  controlNumber    String
  // CLP02: 1 primary, 2 secondary, 3 tertiary, 4 denied, 19-22 forwarded / reversal
  statusCode       String
  billedCents      Int
  paidCents        Int
  patientRespCents Int      @default(0)
  payerClaimNumber String?
  patientName      String?
  memberId         String?
  // JSON [{group, reason, cents}] claim-level + line-level CAS
  adjustments      String   @default("[]")
  // JSON [{code, modifiers, billedCents, paidCents, units, adjustments}]
  lines            String   @default("[]")
  remarks          String?
  // MATCHED | UNMATCHED | POSTED | SKIPPED
  matchStatus      String   @default("UNMATCHED")
  note             String?
  postedAt         DateTime?
}

// ---- Patient flow ----

model AppointmentEvent {
  id            String      @id @default(cuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  status        String
  room          String?
  userId        String?
  at            DateTime    @default(now())

  @@index([appointmentId, at])
}

// ---- Recalls ----

model Recall {
  id            String       @id @default(cuid())
  practiceId    String
  practice      Practice     @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  patientId     String
  patient       Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  providerId    String?
  locationId    String?
  visitType     String?
  dueDate       DateTime
  reason        String
  // OPEN | SCHEDULED | CLOSED
  status        String       @default("OPEN")
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  contactCount  Int          @default(0)
  lastContactAt DateTime?
  lastContactVia String?
  notes         String?
  closedReason  String?
  createdById   String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([practiceId, status, dueDate])
}

// ---- Clinical decision support (care gaps) ----

model CareRule {
  // Specialty pack this belongs to; null = general (shown whatever packs are on).
  specialty  String?
  id           String   @id @default(cuid())
  practiceId   String
  practice     Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  key          String
  name         String
  description  String?
  // Who it applies to (JSON): { ageMin, ageMax, sex, icd10 (prefixes), activeWound, etiologies }
  criteria     String   @default("{}")
  // What satisfies it: LAB:<name>, DOCUMENT:<template key>, VITALS_BP, VITALS_WEIGHT, SMOKING_STATUS, IMMUNIZATION:<name>
  satisfiedBy  String
  intervalDays Int      @default(365)
  message      String
  // ALERT (warning) | INFO
  severity     String   @default("ALERT")
  source       String?
  active       Boolean  @default(true)
  standard     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  overrides    CareRuleOverride[]

  @@unique([practiceId, key])
}

model CareRuleOverride {
  id          String   @id @default(cuid())
  ruleId      String
  rule        CareRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  patientId   String
  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  // DONE (done elsewhere) | NOT_APPLICABLE | REFUSED
  status      String
  note        String?
  until       DateTime?
  userId      String?
  createdAt   DateTime @default(now())

  @@index([patientId, ruleId])
}

// ---- Duplicate patients ----

model DuplicateDismissal {
  id          String   @id @default(cuid())
  practiceId  String
  practice    Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  // Sorted pair "idA|idB"
  pairKey     String
  userId      String?
  createdAt   DateTime @default(now())

  @@unique([practiceId, pairKey])
}

// ---- Prescriptions ----

model Prescription {
  id              String     @id @default(cuid())
  practiceId      String
  practice        Practice   @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  patientId       String
  patient         Patient    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  encounterId     String?
  prescriberId    String
  drug            String
  strength        String?
  form            String?
  route           String?
  sig             String
  quantity        String
  quantityUnit    String?
  refills         Int        @default(0)
  daysSupply      Int?
  dispenseAsWritten Boolean  @default(false)
  controlled      Boolean    @default(false)
  diagnosisCode   String?
  pharmacyName    String?
  pharmacyPhone   String?
  pharmacyFax     String?
  notes           String?
  // DRAFT | SIGNED | SENT | PRINTED | CANCELLED
  status          String     @default("DRAFT")
  // PRINT | FAX | ERX
  sentVia         String?
  sentAt          DateTime?
  faxId           String?
  signedAt        DateTime?
  signedName      String?
  medicationId    String?
  allergyOverride String?
  cancelledReason String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([practiceId, patientId])
}

// ---- Immunizations ----

model Immunization {
  id             String   @id @default(cuid())
  practiceId     String
  practice       Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  patientId      String
  patient        Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  encounterId    String?
  vaccine        String
  cvxCode        String?
  administeredAt DateTime
  // ADMINISTERED | HISTORICAL | REFUSED
  source         String   @default("ADMINISTERED")
  lotNumber      String?
  manufacturer   String?
  expirationDate DateTime?
  site           String?
  route          String?
  doseMl         Float?
  administeredById String?
  refusalReason  String?
  visDate        DateTime?
  notes          String?
  reportedAt     DateTime?
  createdAt      DateTime @default(now())
  // The stock lot the dose was drawn from, when it came from the practice's inventory.
  lotId          String?
  lot            VaccineLot? @relation(fields: [lotId], references: [id], onDelete: SetNull)

  @@index([practiceId, administeredAt])
}

// ---- Letters ----

model LetterTemplate {
  id          String   @id @default(cuid())
  practiceId  String
  practice    Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  key         String
  name        String
  subject     String?
  body        String
  active      Boolean  @default(true)
  standard    Boolean  @default(false)
  updatedAt   DateTime @updatedAt

  @@unique([practiceId, key])
}

// ---- Holidays & closures ----

model ClinicClosure {
  id          String   @id @default(cuid())
  practiceId  String
  practice    Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  // null = every location
  locationId  String?
  date        DateTime
  name        String
  // HOLIDAY | CLOSURE
  kind        String   @default("HOLIDAY")
  // Allow booking anyway (e.g. on-call clinic)
  allowBooking Boolean @default(false)
  createdAt   DateTime @default(now())

  @@index([practiceId, date])
}

// ---- API clients (FHIR) ----

model ApiClient {
  id          String    @id @default(cuid())
  practiceId  String
  practice    Practice  @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  name        String
  tokenHash   String    @unique
  tokenHint   String
  // Space-separated scopes, e.g. "patient/*.read"
  scopes      String    @default("patient/*.read")
  active      Boolean   @default(true)
  lastUsedAt  DateTime?
  createdById String?
  createdAt   DateTime  @default(now())
}

// ---- Online bill pay ----

model PatientPayment {
  id          String    @id @default(cuid())
  practiceId  String
  practice    Practice  @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  patientId   String
  patient     Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  token       String    @unique
  // Balance shown when the link was made; the patient may pay part of it.
  balanceCents Int
  amountCents Int?
  // SENT | PAID | CANCELLED | EXPIRED
  status      String    @default("SENT")
  provider    String    @default("TEST")
  providerRef String?
  depositId   String?
  sentVia     String?
  expiresAt   DateTime
  paidAt      DateTime?
  receiptEmail String?
  verifyAttempts Int     @default(0)
  lockedUntil  DateTime?
  sessionHash  String?
  createdById String?
  createdAt   DateTime  @default(now())

  @@index([practiceId, status])
}

// ---- Lab & imaging orders ----

// A lab, imaging center or vascular lab the practice orders from.
model OrderProvider {
  id          String   @id @default(cuid())
  practiceId  String
  practice    Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  // LAB | IMAGING
  kind        String
  name        String
  phone       String?
  fax         String?
  accountNumber String?
  // FAX | PRINT | ELECTRONIC (HL7 interface, needs the lab's connection)
  sendMethod  String   @default("FAX")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  catalog     OrderCatalogItem[]
  orders      ClinicalOrder[]
}

model OrderCatalogItem {
  // Specialty pack this belongs to; null = general (shown whatever packs are on).
  specialty  String?
  id          String   @id @default(cuid())
  practiceId  String
  practice    Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  providerId  String?
  provider    OrderProvider? @relation(fields: [providerId], references: [id], onDelete: SetNull)
  kind        String
  // LOINC for labs, CPT for imaging
  code        String
  name        String
  category    String?
  specimen    String?
  fasting     Boolean  @default(false)
  favorite    Boolean  @default(true)
  active      Boolean  @default(true)
}

model ClinicalOrder {
  id            String   @id @default(cuid())
  practiceId    String
  practice      Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  patientId     String
  patient       Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  encounterId   String?
  kind          String
  providerId    String?
  provider      OrderProvider? @relation(fields: [providerId], references: [id], onDelete: SetNull)
  orderedById   String
  // Requisition / placer order number printed on the requisition and returned in results.
  requisition   String   @unique
  // DRAFT | SIGNED | SENT | PARTIAL | RESULTED | REVIEWED | CANCELLED
  status        String   @default("DRAFT")
  // ROUTINE | URGENT | STAT
  priority      String   @default("ROUTINE")
  diagnosisCodes String?
  clinicalNotes String?
  fasting       Boolean  @default(false)
  collectedAt   DateTime?
  collectedBy   String?
  scheduledFor  DateTime?
  sentVia       String?
  sentAt        DateTime?
  faxId         String?
  signedAt      DateTime?
  cancelledReason String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  items         ClinicalOrderItem[]
  results       ClinicalResult[]

  @@index([practiceId, status])
}

model ClinicalOrderItem {
  id        String        @id @default(cuid())
  orderId   String
  order     ClinicalOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  code      String
  name      String
  specimen  String?
  // ORDERED | RESULTED | CANCELLED
  status    String        @default("ORDERED")
}

model ClinicalResult {
  id          String        @id @default(cuid())
  orderId     String
  order       ClinicalOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  code        String?
  name        String
  value       String?
  unit        String?
  referenceRange String?
  // NORMAL | HIGH | LOW | ABNORMAL | CRITICAL
  flag        String        @default("NORMAL")
  // Imaging / pathology narrative (impression).
  reportText  String?
  documentId  String?
  // MANUAL | HL7 | DOCUMENT
  source      String        @default("MANUAL")
  resultedAt  DateTime      @default(now())
  reviewedById String?
  reviewedAt  DateTime?
  reviewNote  String?
}

// ---- Front-desk checkout ----

model Receipt {
  id          String   @id @default(cuid())
  practiceId  String
  practice    Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  patientId   String
  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointmentId String?
  encounterId String?
  depositId   String?
  number      String
  // COPAY | BALANCE | PREPAY | OTHER
  kind        String
  amountCents Int
  // CASH | CHECK | CARD | OTHER
  method      String
  reference   String?
  note        String?
  collectedById String?
  voidedAt    DateTime?
  voidReason  String?
  createdAt   DateTime @default(now())

  @@unique([practiceId, number])
  @@index([practiceId, createdAt])
}

// ---- Tasks & staff messages ----

model Task {
  id           String   @id @default(cuid())
  practiceId   String
  practice     Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  // MESSAGE | CALLBACK | LAB_RESULT | IMAGING_RESULT | REFILL | PRIOR_AUTH | REFERRAL | DOCUMENT | BILLING | GENERAL
  type         String   @default("GENERAL")
  title        String
  body         String?
  patientId    String?
  patient      Patient? @relation(fields: [patientId], references: [id], onDelete: SetNull)
  assignedToId String?
  // A team inbox when not assigned to one person (role code, e.g. FRONT_DESK).
  assignedRole String?
  createdById  String?
  // LOW | NORMAL | HIGH | URGENT
  priority     String   @default("NORMAL")
  // OPEN | DONE | CANCELLED
  status       String   @default("OPEN")
  dueAt        DateTime?
  link         String?
  sourceType   String?
  sourceId     String?
  completedAt  DateTime?
  completedById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  comments     TaskComment[]

  @@index([practiceId, status, assignedToId])
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String?
  body      String
  createdAt DateTime @default(now())
}

// ---- Outgoing referrals ----

model OutgoingReferral {
  id            String   @id @default(cuid())
  practiceId    String
  practice      Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  patientId     String
  patient       Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  encounterId   String?
  // Directory entry (referring / outside physician) or a free-text recipient.
  toProviderId  String?
  toName        String
  toSpecialty   String?
  toFax         String?
  toPhone       String?
  reason        String
  diagnosisCodes String?
  notes         String?
  // ROUTINE | URGENT
  urgency       String   @default("ROUTINE")
  authNumber    String?
  // DRAFT | SENT | SCHEDULED | CONSULT_RECEIVED | CLOSED | CANCELLED
  status        String   @default("DRAFT")
  sentVia       String?
  sentAt        DateTime?
  faxId         String?
  letterDocumentId String?
  appointmentAt DateTime?
  consultDocumentId String?
  consultReceivedAt DateTime?
  followUpDays  Int      @default(30)
  closedReason  String?
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([practiceId, status])
}

// ---- Bulk patient import ----

model ImportBatch {
  id          String   @id @default(cuid())
  practiceId  String
  practice    Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  fileName    String
  // PATIENTS | COVERAGE | BALANCES | APPOINTMENTS
  kind        String   @default("PATIENTS")
  // PREVIEW | IMPORTED | UNDONE
  status      String   @default("PREVIEW")
  // JSON: column mapping, parsed rows with validation results
  mapping     String   @default("{}")
  rows        String   @default("[]")
  totalRows   Int      @default(0)
  createdCount Int     @default(0)
  skippedCount Int     @default(0)
  // JSON array of created patient ids (for undo)
  createdIds  String   @default("[]")
  createdById String?
  createdAt   DateTime @default(now())
  importedAt  DateTime?
}

// Authorizations a payer granted for a coverage: a number of visits (ENCOUNTER) or of a procedure (PROCEDURE) in a date range.
model InsuranceAuthorization {
  id               String    @id @default(cuid())
  practiceId       String
  patientId        String
  insuranceId      String
  insurance        Insurance @relation(fields: [insuranceId], references: [id], onDelete: Cascade)
  // ENCOUNTER | PROCEDURE
  kind             String    @default("ENCOUNTER")
  reason           String?
  // CPT / HCPCS the authorization covers (PROCEDURE only)
  procedureCode    String?
  authNumber       String?
  authorizedCount  Int?
  startDate        DateTime?
  endDate          DateTime?
  insuranceContact String?
  verifiedAt       DateTime?
  verifiedBy       String?
  notes            String?
  createdById      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([patientId])
}

// ---- Privacy and compliance ----

// Accounting of disclosures (45 CFR 164.528): each release of the patient's information outside treatment,
// payment and operations, kept for six years.
model Disclosure {
  id          String   @id @default(cuid())
  practiceId  String
  practice    Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  patientId   String
  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  disclosedAt DateTime
  recipient   String
  recipientAddress String?
  // PATIENT_REQUEST | AUTHORIZATION | LEGAL | PUBLIC_HEALTH | OVERSIGHT | LAW_ENFORCEMENT | RESEARCH | WORKERS_COMP | OTHER
  purpose     String
  // What was released, e.g. "Progress notes 01/2026 to 06/2026".
  description String
  // FAX | MAIL | ELECTRONIC | IN_PERSON | VERBAL
  method      String?
  notes       String?
  createdById String?
  createdAt   DateTime @default(now())

  @@index([practiceId, disclosedAt])
  @@index([patientId])
}

// A patient's request to amend their record (45 CFR 164.526). The practice answers within 60 days.
model AmendmentRequest {
  id           String   @id @default(cuid())
  practiceId   String
  practice     Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  patientId    String
  patient      Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  requestedAt  DateTime
  // Who asked: the patient or their representative.
  requestedBy  String
  // Which part of the record, e.g. "Problem list", "Visit note 03/02/2026".
  section      String
  requestText  String
  reason       String?
  // PENDING | ACCEPTED | DENIED
  status       String   @default("PENDING")
  dueAt        DateTime
  decidedAt    DateTime?
  decidedById  String?
  decisionNote String?
  // NOT_CREATED_HERE | NOT_PART_OF_RECORD | NOT_AVAILABLE_FOR_INSPECTION | ACCURATE_AND_COMPLETE
  denialReason String?
  patientNotifiedAt DateTime?
  disagreement String?
  createdById  String?
  createdAt    DateTime @default(now())

  @@index([practiceId, status])
  @@index([patientId])
}

// "Break the glass": a staff member outside the care team opened a restricted chart after giving a reason.
model EmergencyAccess {
  id           String   @id @default(cuid())
  practiceId   String
  practice     Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  patientId    String
  patient      Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  userId       String
  // EMERGENCY | COVERING | BILLING | PATIENT_REQUEST | OTHER
  reason       String
  note         String?
  grantedAt    DateTime @default(now())
  expiresAt    DateTime
  reviewedById String?
  reviewedAt   DateTime?
  reviewNote   String?

  @@index([practiceId, grantedAt])
  @@index([patientId, userId])
}

// ---- Care plan ----

model CareTeamMember {
  id           String   @id @default(cuid())
  practiceId   String
  practice     Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  patientId    String
  patient      Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  name         String
  // PCP | WOUND_CARE | SPECIALIST | NURSE | HOME_HEALTH | CASE_MANAGER | PHARMACIST | THERAPIST | CAREGIVER | OTHER
  role         String
  specialty    String?
  organization String?
  phone        String?
  fax          String?
  email        String?
  // Set when the member is a CareHub user; gives them access to a restricted chart.
  userId       String?
  startDate    DateTime?
  endDate      DateTime?
  active       Boolean  @default(true)
  notes        String?
  createdAt    DateTime @default(now())

  @@index([patientId])
}

model HealthConcern {
  id          String   @id @default(cuid())
  practiceId  String
  practice    Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  patientId   String
  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  concern     String
  // CLINICAL | FUNCTIONAL | SOCIAL | BEHAVIORAL | OTHER
  category    String   @default("CLINICAL")
  // ACTIVE | RESOLVED
  status      String   @default("ACTIVE")
  notedAt     DateTime @default(now())
  resolvedAt  DateTime?
  notes       String?
  createdById String?
  goals       PatientGoal[]

  @@index([patientId])
}

model PatientGoal {
  id            String   @id @default(cuid())
  practiceId    String
  practice      Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  patientId     String
  patient       Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  goal          String
  // PATIENT (in the patient's words) | PROVIDER
  kind          String   @default("PROVIDER")
  concernId     String?
  concern       HealthConcern? @relation(fields: [concernId], references: [id], onDelete: SetNull)
  // What the team will do to reach it.
  interventions String?
  targetDate    DateTime?
  // ACTIVE | ACHIEVED | NOT_MET | CANCELLED
  status        String   @default("ACTIVE")
  progressNote  String?
  closedAt      DateTime?
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([patientId])
}

model ImplantableDevice {
  id           String   @id @default(cuid())
  practiceId   String
  practice     Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  patientId    String
  patient      Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  deviceName   String
  // Unique device identifier from the label or implant card.
  udi          String?
  manufacturer String?
  model        String?
  lotNumber    String?
  serialNumber String?
  site         String?
  implantedAt  DateTime?
  // ACTIVE | REMOVED
  status       String   @default("ACTIVE")
  removedAt    DateTime?
  notes        String?
  createdAt    DateTime @default(now())

  @@index([patientId])
}

// Social needs screening. The questions live in src/lib/sdoh.ts; answers are stored by question key.
model SdohScreening {
  id           String   @id @default(cuid())
  practiceId   String
  practice     Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  patientId    String
  patient      Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  encounterId  String?
  screenedAt   DateTime @default(now())
  declined     Boolean  @default(false)
  // JSON { questionKey: answerCode }
  answers      String   @default("{}")
  // Comma separated domains with a need found (HOUSING,FOOD,...).
  needs        String   @default("")
  notes        String?
  screenedById String?

  @@index([patientId, screenedAt])
}

// ---- Setup ----

// Extra fields a practice adds to the patient registration form.
model CustomField {
  id         String   @id @default(cuid())
  practiceId String
  practice   Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  key        String
  label      String
  // TEXT | NUMBER | DATE | CHECKBOX | SELECT
  type       String   @default("TEXT")
  // One choice per line (SELECT only).
  options    String?
  helpText   String?
  required   Boolean  @default(false)
  order      Int      @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@unique([practiceId, key])
}

model VaccineLot {
  id             String   @id @default(cuid())
  practiceId     String
  practice       Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  vaccine        String
  cvxCode        String?
  manufacturer   String?
  lotNumber      String
  expirationDate DateTime?
  dosesReceived  Int
  dosesOnHand    Int
  // PRIVATE | VFC | STATE
  funding        String   @default("PRIVATE")
  receivedAt     DateTime @default(now())
  notes          String?
  active         Boolean  @default(true)
  immunizations  Immunization[]

  @@index([practiceId, active])
}

// The kinds of site a practice visits (assisted living, SNF, home, ...). Sites of service pick one.
model ServiceType {
  id         String   @id @default(cuid())
  practiceId String
  practice   Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  name       String
  createdAt  DateTime @default(now())
  locations  Location[]

  @@unique([practiceId, name])
}

// Charge schedule: what the practice charges for each billing code, for a set of sites, providers and
// insurances over a date range. A visit takes its fees from the schedule that covers it.
model ChargeSchedule {
  id          String   @id @default(cuid())
  practiceId  String
  practice    Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  name        String
  startDate   DateTime
  endDate     DateTime?
  active      Boolean  @default(true)
  // JSON arrays of ids. An empty list means the schedule applies to all of them.
  locationIds String   @default("[]")
  providerIds String   @default("[]")
  payerIds    String   @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  items       ChargeScheduleItem[]

  @@index([practiceId, active])
}

model ChargeScheduleItem {
  id          String         @id @default(cuid())
  scheduleId  String
  schedule    ChargeSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  code        String
  description String
  feeCents    Int            @default(0)
  // UB-04 revenue code (4 characters) for facility claims.
  // Expected reimbursement for the code under this schedule (an allowable schedule); null = not known.
  allowedCents Int?
  revenueCode String?

  @@unique([scheduleId, code])
}

// Credentialing documents that belong to a group (billing provider): W-9, EFT form, IRS letter, liability cover.
model GroupDocument {
  id                String          @id @default(cuid())
  billingProviderId String
  billingProvider   BillingProvider @relation(fields: [billingProviderId], references: [id], onDelete: Cascade)
  type              String
  fileName          String
  filePath          String
  mimeType          String
  issueDate         DateTime?
  expiryDate        DateTime?
  supersededAt      DateTime?
  uploadedById      String?
  createdAt         DateTime        @default(now())

  @@index([billingProviderId])
}

// Plan names under a payer (e.g. "Aetna Medicare Advantage" -> "Aetna Medicare Eagle PPO"). Credentialing marks
// each one approved or not; plan names the VOB team enters on patients arrive here to be reviewed.
model PayerPlan {
  id          String   @id @default(cuid())
  practiceId  String
  practice    Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  payerId     String
  payer       Payer    @relation(fields: [payerId], references: [id], onDelete: Cascade)
  name        String
  // Lower-cased, punctuation-free name used to match what VOB typed.
  nameKey     String
  planSegment String?
  // REVIEW (not decided yet) | APPROVED | NOT_APPROVED
  status      String   @default("REVIEW")
  // CREDENTIALING (added by the credentialing team) | VOB (first seen on a patient's coverage)
  source      String   @default("CREDENTIALING")
  notes       String?
  // How many patient coverages and intake cases carry this plan name, and when it was last seen.
  seenCount   Int      @default(0)
  lastSeenAt  DateTime?
  decidedById String?
  decidedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([payerId, nameKey])
  @@index([practiceId, status])
}

// A clearinghouse's published payer list: one row per payer with the ID that clearinghouse uses for it and the
// transactions it takes. Shared by every practice on that clearinghouse; the insurance form looks payers up here.
model PayerCatalogEntry {
  id            String   @id @default(cuid())
  clearinghouse String
  payerId       String
  name          String
  relatedNames  String?
  payerClass    String?
  // Where a clearinghouse uses one ID per transaction: institutional claims, remits, eligibility, and the
  // payer's industry-standard ID. payerId is the (professional) claims ID.
  institutionalId String?
  eraId           String?
  eligibilityId   String?
  standardId      String?
  enrollmentNote  String?
  professional  Boolean  @default(true)
  institutional Boolean  @default(false)
  remits        Boolean  @default(false)
  eligibility   Boolean  @default(false)
  addressLine1  String?
  addressLine2  String?
  city          String?
  state         String?
  zip           String?
  phone         String?
  loadedAt      DateTime @default(now())

  @@index([clearinghouse, payerId])
  @@index([clearinghouse, name])
}

// The code library: ICD-10-CM, HCPCS Level II and (from the practice's licensed file) CPT, held once for every
// practice. Charge schedules, the superbill and practice code lists pick from it.
model MasterCode {
  id               String   @id @default(cuid())
  // ICD10 | HCPCS | CPT
  codeSet          String
  code             String
  description      String
  shortDescription String?
  // False for ICD-10-CM category headings, which cannot go on a claim.
  billable         Boolean  @default(true)
  edition          String?
  loadedAt         DateTime @default(now())

  @@unique([codeSet, code])
  @@index([codeSet, billable])
}

// A message from one team to another about a patient. Kept on the patient, shown wherever that patient is worked
// (chart, gateway case, visit, claim). A message that needs a reply stays open until the addressed team answers.
model PatientMessage {
  id           String    @id @default(cuid())
  practiceId   String
  practice     Practice  @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  patientId    String
  patient      Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  authorId     String?
  // The author's team when the message was written.
  authorRole   String?
  // The team it is for (a role); empty for a note to everyone on the patient.
  toTeam       String?
  body         String
  needsReply   Boolean   @default(false)
  answeredAt   DateTime?
  answeredById String?
  replyToId    String?
  // Where it was written from, so the reader can open that screen.
  link         String?
  createdAt    DateTime  @default(now())

  @@index([practiceId, patientId, createdAt])
  @@index([practiceId, toTeam, needsReply, answeredAt])
}

// ---- Treatment-note product engine (wound pack): the practice's dressing/product catalog and the steps of a
// treatment, so a treatment note is built from configured products instead of typed free text. ----

model WoundProduct {
  id          String   @id @default(cuid())
  practiceId  String
  practice    Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  name        String
  brand       String?
  // CLEANSER | PRIMARY | SECONDARY | ANTIMICROBIAL | ENZYMATIC | COLLAGEN | CTP | NPWT | COMPRESSION | OFFLOADING | SKIN_PROTECTANT | OTHER
  productType String   @default("PRIMARY")
  // HCPCS supply code billed per unit (A6xxx, Q4xxx...), when the practice bills the product.
  hcpcsCode   String?
  unit        String   @default("each")
  size        String?
  instructions String?
  active      Boolean  @default(true)
  standard    Boolean  @default(false)
  sortOrder   Int      @default(100)
  createdAt   DateTime @default(now())
  lines       WoundTreatmentLine[]

  @@index([practiceId, productType])
}

model TreatmentStep {
  id         String   @id @default(cuid())
  practiceId String
  practice   Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  name       String
  // Product types that fit this step (comma list); empty = any.
  productTypes String @default("")
  active     Boolean  @default(true)
  standard   Boolean  @default(false)
  sortOrder  Int      @default(100)
  lines      WoundTreatmentLine[]
}

model WoundTreatment {
  id            String    @id @default(cuid())
  practiceId    String
  practice      Practice  @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  encounterId   String
  encounter     Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  woundId       String
  wound         Wound     @relation(fields: [woundId], references: [id], onDelete: Cascade)
  performedById String?
  performedBy   User?     @relation(fields: [performedById], references: [id], onDelete: SetNull)
  notes         String?
  // Set when the billable products were pushed to the superbill.
  billedAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lines         WoundTreatmentLine[]

  @@unique([encounterId, woundId])
}

model WoundTreatmentLine {
  id           String         @id @default(cuid())
  treatmentId  String
  treatment    WoundTreatment @relation(fields: [treatmentId], references: [id], onDelete: Cascade)
  stepId       String?
  step         TreatmentStep? @relation(fields: [stepId], references: [id], onDelete: SetNull)
  stepName     String
  productId    String?
  product      WoundProduct?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName  String
  quantity     Float          @default(1)
  unit         String         @default("each")
  instructions String?
  sortOrder    Int            @default(0)
}

// A sticky note on a patient that shows wherever the patient is opened, in the chosen places, during its dates.
model PatientAlert {
  id             String    @id @default(cuid())
  practiceId     String
  practice       Practice  @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  patientId      String
  patient        Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  type           String
  severity       String    @default("WARNING")
  message        String
  // Comma-separated placements: chart, schedule, checkin, billing.
  showOn         String
  activeFrom     DateTime  @default(now())
  activeTo       DateTime?
  assignedToId   String?
  assignedTo     User?     @relation("AlertAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  status         String    @default("ACTIVE")
  createdById    String?
  createdBy      User?     @relation("AlertCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime  @default(now())
  resolvedById   String?
  resolvedBy     User?     @relation("AlertResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt     DateTime?
  resolveComment String?
  acknowledgements AlertAcknowledgement[]

  @@index([practiceId, patientId, status])
}

// Who saw a STOP alert, where and when; booking and check-in need one from the person doing the step.
model AlertAcknowledgement {
  id        String       @id @default(cuid())
  alertId   String
  alert     PatientAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  placement String
  createdAt DateTime     @default(now())

  @@index([alertId, userId, createdAt])
}

// One run of a background job (scheduled or by hand), with its outcome.
model JobRun {
  id          String    @id @default(cuid())
  job         String
  triggeredBy String    @default("SCHEDULE")
  userId      String?
  status      String    @default("RUNNING")
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  summary     String?
  error       String?

  @@index([job, startedAt])
}

// One worked AR item per claim: why it is open, who owns it, how urgent, when to look again, and the SLA.
model ClaimFollowUp {
  id             String    @id @default(cuid())
  practiceId     String
  practice       Practice  @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  claimId        String
  claim          Claim     @relation(fields: [claimId], references: [id], onDelete: Cascade)
  trigger        String
  status         String    @default("OPEN")
  note           String?
  lastAction     String?
  ownerId        String?
  owner          User?     @relation("FollowUpOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  priority       Int       @default(0)
  balanceCents   Int       @default(0)
  expectedCents  Int?
  paidCents      Int?
  tickleAt       DateTime?
  tickles        Int       @default(0)
  slaDueAt       DateTime?
  deadlineAt     DateTime?
  escalatedAt    DateTime?
  resolvedReason String?
  resolvedAt     DateTime?
  lastActionAt   DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([practiceId, status, priority])
  @@index([claimId])
}

// How claims to a payer are built, effective by date of service. One set applies at a time.
model PayerRuleSet {
  id                  String    @id @default(cuid())
  practiceId          String
  practice            Practice  @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  payerId             String
  payer               Payer     @relation(fields: [payerId], references: [id], onDelete: Cascade)
  effectiveFrom       DateTime
  effectiveTo         DateTime?
  submissionType      String    @default("ELECTRONIC")
  paperForm           String    @default("CMS1500")
  claimPayerId        String?
  eligibilityPayerId  String?
  statusPayerId       String?
  crossover           String    @default("AUTO")
  renderingRule       String    @default("ALWAYS")
  serviceLocationRule String    @default("ALWAYS")
  homeBound           Boolean   @default(false)
  hold                Boolean   @default(false)
  holdReason          String?
  holdUntil           DateTime?
  notes               String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  overrides           PayerBillingOverride[]

  @@index([practiceId, payerId, effectiveFrom])
}

// Whom to bill under, which tax identifier and which pay-to address, for a site and/or rendering provider.
model PayerBillingOverride {
  id                  String            @id @default(cuid())
  ruleSetId           String
  ruleSet             PayerRuleSet      @relation(fields: [ruleSetId], references: [id], onDelete: Cascade)
  locationId          String?
  location            Location?         @relation(fields: [locationId], references: [id], onDelete: Cascade)
  renderingProviderId String?
  renderingProvider   RenderingProvider? @relation(fields: [renderingProviderId], references: [id], onDelete: Cascade)
  billUnder           String            @default("PRACTICE")
  taxIdType           String            @default("EIN")
  payTo               String            @default("PRACTICE")
  payToName           String?
  payToLine1          String?
  payToLine2          String?
  payToCity           String?
  payToState          String?
  payToZip            String?
  taxonomy            String?
  legacyId            String?
}

// A column mapping remembered per practice and kind of file, keyed by the file's header row.
model ImportMapping {
  id         String   @id @default(cuid())
  practiceId String
  practice   Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  kind       String
  signature  String
  name       String
  map        String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([practiceId, kind, signature])
}

// A user's saved report view (cadence NONE) or a scheduled CSV delivery by email.
model ReportSubscription {
  id          String    @id @default(cuid())
  practiceId  String
  practice    Practice  @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  reportKey   String
  name        String
  cadence     String    @default("NONE")
  rangePreset String    @default("LAST_7")
  active      Boolean   @default(true)
  lastSentAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([practiceId, userId])
}

// A built-in data-quality check switched on for a practice, with its threshold, recipients and last result.
model MonitoringRule {
  id         String    @id @default(cuid())
  practiceId String
  practice   Practice  @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  checkKey   String
  active     Boolean   @default(true)
  threshold  Int       @default(1)
  recipients String?
  lastRunAt  DateTime?
  lastCount  Int?
  lastDetail String?
  createdAt  DateTime  @default(now())

  @@unique([practiceId, checkKey])
}

// A dot-phrase: ".shortcut" expands to text in any note field. userId null = the practice set.
model TextMacro {
  id          String   @id @default(cuid())
  practiceId  String
  practice    Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  shortcut    String
  section     String   @default("UNIVERSAL")
  text        String
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([practiceId, userId, shortcut])
}

// Education material or instructions attached to a visit, printed on the visit summary.
model EducationResource {
  id          String    @id @default(cuid())
  practiceId  String
  practice    Practice  @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  encounterId String
  encounter   Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  patientId   String
  patient     Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  title       String
  url         String?
  summary     String?
  source      String    @default("Provider")
  language    String    @default("en")
  forCode     String?
  addedById   String?
  createdAt   DateTime  @default(now())

  @@index([encounterId])
}

// A result message received from a lab/imaging interface (HL7 v2 ORU, FHIR DiagnosticReport or an uploaded
// file). The raw payload is kept so a message can be re-filed after the order is linked or corrected.
model InterfaceMessage {
  id          String    @id @default(cuid())
  practiceId  String
  practice    Practice  @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  apiClientId String?
  // HL7 | FHIR | FILE
  channel     String    @default("HL7")
  messageType String?
  controlId   String?
  sender      String?
  raw         String
  // RECEIVED | FILED | PARTIAL | UNMATCHED | FAILED | DISCARDED
  status      String    @default("RECEIVED")
  patientHint String?
  requisition String?
  orderId     String?
  filedCount  Int       @default(0)
  detail      String?
  ack         String?
  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  @@index([practiceId, status, receivedAt])
}
