{
  "name": "carehub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "patch-package && prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "setup": "prisma migrate dev --name init && tsx prisma/seed.ts",
    "import:credentialing": "tsx scripts/import-credentialing.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@napi-rs/canvas": "^1.0.9",
    "@prisma/client": "^6.16.2",
    "@tesseract.js-data/eng": "^1.0.0",
    "@types/qrcode": "^1.5.6",
    "fast-xml-parser": "^5.11.2",
    "next": "^15.5.4",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9",
    "eslint-config-next": "^15.5.4",
    "patch-package": "^8.0.1",
    "prisma": "^6.16.2",
    "tailwindcss": "^4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
